advance(mass,inertia,radius,normal_load,drive,v,omega,spin,dt,mu_s,mu_d,mu_r,rolling_length,mu_n,spin_length):
 result:supported_contact_si(
  num((mass+0kg)/kg),
  num((inertia+0kg*m^2)/(kg*m^2)),
  num((radius+0m)/m),
  num((normal_load+0kg*m/s^2)/(kg*m/s^2)),
  num((drive+0kg*m/s^2)/(kg*m/s^2)),
  num((v+0m/s)/(m/s)),
