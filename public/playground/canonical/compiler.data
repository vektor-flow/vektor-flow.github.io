  num((spin+0rad/s)/(rad/s)),
  num((dt+0s)/s),
  num((mu_s+0rad)/rad),num((mu_d+0rad)/rad),num((mu_r+0rad)/rad),
  num((rolling_length+0m)/m),num((mu_n+0rad)/rad),num((spin_length+0m)/m)
 )
 (
  v:result.0*m/s,
