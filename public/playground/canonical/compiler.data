# Collection algorithms are VKF source; canonical list/map/queue storage and
# ownership are compiler intrinsics. Statically named maps use ordinary typed
# record layout, preserving exact metadata types without a hash-table penalty.

collections_stdlib_capability:
    name: "collections"
    constructors: ["map", "list", "queue"]
    direct: [
        "numeric dynamic list construction, indexing, update, ownership, and concatenation",
        "statically named heterogeneous maps through typed record layout",
        "numeric FIFO queues through an owned list plus monotonic head index"
    ]
    :
# Explicit synchronous OS-command execution. `run` passes an exact argument
# vector without invoking a shell. `shell` is the explicit platform-shell
# boundary: never build its command from untrusted text.

run(program:str, args:any) -> (code:int,out:str,err:str):
    command.run_native(program, args)

shell(command:str) -> (code:int,out:str,err:str):
    command.shell_native(command)
# Event and I/O concurrency.  Numerical parallelism remains compiler-managed
# Quantum work; this module is deliberately about isolated processes and
# message ownership, not GPU launches or parallel loops.

# The public entry points are compiler/runtime intrinsics.  They are not
# redeclared with invented variadic syntax here: the handover deliberately
# leaves the final core variadic declaration spelling open.  The compiler
# exports `process`, `queue`, `broadcast`, and `shared` using ordinary call
# binding, so process invocation inherits that final spelling unchanged.

concurrent_stdlib_capability:
    name: "concurrent"
    concepts: ["process", "queue", "broadcast", "shared"]
    process: ["starts immediately", "join returns worker result", "kill is forced termination"]
    queue: ["FIFO", "destructive receive", "get blocks without polling"]
    broadcast: ["many producers", "one queue-like branch per subscriber", "active subscribers receive every later value"]
    shared: ["one arbitrary immutable VKF value", "published generations", "no mutable shared-pointer API"]
    :
# Error types are compiler-owned values because catch ranking and unwinding need
# stable bit masks. This records the public, host-independent namespace; no
# Python exception class participates in direct artifacts.

errors_stdlib_capability:
    name: "errors"
    types: [
        "Error", "VektorFlowError", "LexError", "ParseError", "EvalError",
        "AssertionError", "PythonError", "TypeError", "ValueError",
        "KeyError", "IndexError", "FileNotFoundError", "RuntimeError"
    ]
    implementation: "compiler intrinsic type masks, propagation, catch ranking, and unwind"
    :
# Direct I/O keeps presentation policy in VKF and exposes only capabilities
# that must cross the operating-system boundary. File byte buffers use `str`
# storage because the language deliberately has no separate bytes primitive.

io_stdlib_capability:
    name: "io"
    source_policy: ["UTF-8 text", "string-backed byte buffers"]
    runtime_abi: ["stdin", "stdout", "stderr", "open", "read", "write", "seek", "close"]
    direct: ["print", "eprint", "read_line", "read_text", "write_text", "append_text", "read_bytes", "write_bytes"]
    :
io: .io

path: "build/native-extended-libs/io-direct-" & "smoke.txt"
text: "direct UTF-8: " & "hej"
io.write_text(path, text)
:: io.read_text(path)

bytes_path: "build/native-extended-libs/io-direct-smoke.bin"
io.write_bytes(bytes_path, "byte-exact UTF-8")
:: io.read_bytes(bytes_path)
# Linear algebra over ordinary VKF vectors and rectangular nested vectors.
# Algorithms live in VKF source; no Matrix wrapper or host-language fallback.

m: .math
errors: .errors

_linalg_abs(value:num) -> num:
    m.abs(value)

_linalg_numeric_dot(left:[num:n], right:[num:n]) -> num:
    result: 0
    count: left.length()
    count > 0?
        ..count - 1 >>
            .result+: left.($) * right.($)
    result

dot(left:[num:n], right:[num:n]) -> num:
    _linalg_numeric_dot(left, right)

dot(left:[expression:n], right:[expression:n]) -> expression:
    result: constant(0)
    count: left.length()
    count > 0?
        ..count - 1 >>
            .result: simplify(result + simplify(left.($) * right.($)))
    simplify(result)

cross(left:[num:3], right:[num:3]) -> [num:3]:
    [
        left.1 * right.2 - left.2 * right.1,
        left.2 * right.0 - left.0 * right.2,
        left.0 * right.1 - left.1 * right.0
    ]

outer(left:[num:n], right:[num:m]):
    left->i * right->j

matmul(left:[[num:k]:r], right:[[num:c]:k]) -> [[num:c]:r]:
    first_row: right.0
    result: [left >> [first_row >> 0.0]]
    ..left.length() - 1 >>
        row: $
        ..first_row.length() - 1 >>
            column: $
            total: 0
            ..right.length() - 1 >>
                inner: $
                .total+: left.(row, inner) * right.(inner, column)
            result.(row, column): total
    result

transpose(matrix:[[num:c]:r]) -> [[num:r]:c]:
    first_row: matrix.0
    result: [first_row >> [matrix >> 0.0]]
    ..matrix.length() - 1 >>
        row: $
        ..first_row.length() - 1 >>
            column: $
            result.(column, row): matrix.(row, column)
    result

diag(values:[num:n]) -> [[num:n]:n]:
    result: [values >> values * 0.0]
    values.length() > 0?
        ..values.length() - 1 >>
            result.($, $): values.($)
    result

trace(matrix:[[num:n]:n]) -> num:
    result: 0
    matrix.length() > 0?
        ..matrix.length() - 1 >>
            .result+: matrix.($, $)
    result

determinant(matrix:[[num:n]:n], tolerance:num=0.000000000001) -> num:
    working: matrix * 1.0
    size: matrix.length()
    result: 1
    sign: 1
    temporary_value: 0
    size > 0?
        ..size - 1 >>
            column: $
            pivot: column
            pivot_magnitude: _linalg_abs(working.(column, column))
            column + 1 < size?
                (column + 1)..size - 1 >>
                    candidate: $
                    candidate_magnitude: _linalg_abs(working.(candidate, column))
                    candidate_magnitude > pivot_magnitude?
                        .pivot: candidate
                        .pivot_magnitude: candidate_magnitude
            pivot_magnitude <= tolerance? @: 0
            pivot != column?
                ..size - 1 >>
                    swap_column: $
                    .temporary_value: working.(pivot, swap_column)
                    working.(pivot, swap_column): working.(column, swap_column)
                    working.(column, swap_column): temporary_value
                .sign: 0 - sign
            pivot_value: working.(column, column)
            .result*: pivot_value
            column + 1 < size?
                (column + 1)..size - 1 >>
                    row: $
                    factor: working.(row, column) / pivot_value
                    working.(row, column): 0
                    (column + 1)..size - 1 >>
                        target: $
                        working.(row, target): working.(row, target) - factor * working.(column, target)
    sign * result

solve(matrix:[[num:n]:n], values:[num:n], tolerance:num=0.000000000001) -> [num:n]:
    working: matrix * 1.0
    right: values * 1.0
    size: values.length()
    temporary_value: 0
    temporary_right: 0
    size > 0?
        ..size - 1 >>
            column: $
            pivot: column
            pivot_magnitude: _linalg_abs(working.(column, column))
            column + 1 < size?
                (column + 1)..size - 1 >>
                    candidate: $
                    candidate_magnitude: _linalg_abs(working.(candidate, column))
                    candidate_magnitude > pivot_magnitude?
                        .pivot: candidate
                        .pivot_magnitude: candidate_magnitude
            pivot_magnitude <= tolerance?
                errors.ValueError("linalg.solve matrix is singular")!
            pivot != column?
                ..size - 1 >>
                    swap_column: $
                    .temporary_value: working.(pivot, swap_column)
                    working.(pivot, swap_column): working.(column, swap_column)
                    working.(column, swap_column): temporary_value
                .temporary_right: right.(pivot)
                right.(pivot): right.(column)
                right.(column): temporary_right
            pivot_value: working.(column, column)
            column + 1 < size?
                (column + 1)..size - 1 >>
                    row: $
                    factor: working.(row, column) / pivot_value
                    working.(row, column): 0
                    (column + 1)..size - 1 >>
                        target: $
                        working.(row, target): working.(row, target) - factor * working.(column, target)
                    right.(row): right.(row) - factor * right.(column)
    result: right * 0
    size > 0?
        (size - 1)..0 >>
            row: $
            total: right.(row)
            row + 1 < size?
                (row + 1)..size - 1 >>
                    column: $
                    .total-: working.(row, column) * result.(column)
            result.(row): total / working.(row, row)
    result

inverse(matrix:[[num:n]:n], tolerance:num=0.000000000001) -> [[num:n]:n]:
    result: matrix * 0
    basis: matrix.0 * 0
    size: matrix.length()
    size > 0?
        ..size - 1 >>
            column: $
            .basis: matrix.0 * 0
            basis.(column): 1
            solution: solve(matrix, basis, tolerance)
            ..size - 1 >>
                row: $
                result.(row, column): solution.(row)
    result

rref(matrix:[[num:c]:r], tolerance:num=0.000000000001) -> [[num:c]:r]:
    working: matrix * 1.0
    row_count: matrix.length()
    column_count: matrix.0.length()
    pivot_row: 0
    pivot: 0
    pivot_magnitude: 0
    candidate_magnitude: 0
    pivot_value: 0
    factor: 0
    temporary_value: 0
    column_count > 0?
        ..column_count - 1 >>
            column: $
            pivot_row < row_count?
                .pivot: pivot_row
                .pivot_magnitude: _linalg_abs(working.(pivot_row, column))
                pivot_row + 1 < row_count?
                    (pivot_row + 1)..row_count - 1 >>
                        candidate: $
                        .candidate_magnitude: _linalg_abs(working.(candidate, column))
                        candidate_magnitude > pivot_magnitude?
                            .pivot: candidate
                            .pivot_magnitude: candidate_magnitude
                pivot_magnitude > tolerance?
                    pivot != pivot_row?
                        ..column_count - 1 >>
                            swap_column: $
                            .temporary_value: working.(pivot, swap_column)
                            working.(pivot, swap_column): working.(pivot_row, swap_column)
                            working.(pivot_row, swap_column): temporary_value
                    .pivot_value: working.(pivot_row, column)
                    ..column_count - 1 >>
                        target: $
                        working.(pivot_row, target): working.(pivot_row, target) / pivot_value
                    ..row_count - 1 >>
                        row: $
                        row != pivot_row?
                            .factor: working.(row, column)
                            _linalg_abs(factor) > tolerance?
                                ..column_count - 1 >>
                                    target: $
                                    working.(row, target): working.(row, target) - factor * working.(pivot_row, target)
                    .pivot_row+: 1
    working

rank(matrix:[[num:c]:r], tolerance:num=0.000000000001) -> int:
    reduced: rref(matrix, tolerance)
    result: 0
    row_nonzero: false
    matrix.length() > 0?
        ..matrix.length() - 1 >>
            row: $
            .row_nonzero: false
            matrix.0.length() > 0?
                ..matrix.0.length() - 1 >>
                    column: $
                    _linalg_abs(reduced.(row, column)) > tolerance?
                        .row_nonzero: true
            row_nonzero?
                .result+: 1
    result

lu(matrix:[[num:n]:n], tolerance:num=0.000000000001):
    lower: matrix * 0
    upper: matrix * 1.0
    permutation: matrix.0 * 0
    size: matrix.length()
    sign: 1
    pivot: 0
    pivot_magnitude: 0
    candidate_magnitude: 0
    pivot_value: 0
    factor: 0
    temporary_value: 0
    temporary_permutation: 0
    size > 0?
        ..size - 1 >>
            index: $
            lower.(index, index): 1
            permutation.(index): index
        ..size - 1 >>
            column: $
            .pivot: column
            .pivot_magnitude: _linalg_abs(upper.(column, column))
            column + 1 < size?
                (column + 1)..size - 1 >>
                    candidate: $
                    .candidate_magnitude: _linalg_abs(upper.(candidate, column))
                    candidate_magnitude > pivot_magnitude?
                        .pivot: candidate
                        .pivot_magnitude: candidate_magnitude
            pivot_magnitude <= tolerance?
                errors.ValueError("linalg.lu matrix is singular")!
            pivot != column?
                ..size - 1 >>
                    swap_column: $
                    .temporary_value: upper.(pivot, swap_column)
                    upper.(pivot, swap_column): upper.(column, swap_column)
                    upper.(column, swap_column): temporary_value
                column > 0?
                    ..column - 1 >>
                        prior: $
                        .temporary_value: lower.(pivot, prior)
                        lower.(pivot, prior): lower.(column, prior)
                        lower.(column, prior): temporary_value
                .temporary_permutation: permutation.(pivot)
                permutation.(pivot): permutation.(column)
                permutation.(column): temporary_permutation
                .sign: 0 - sign
            .pivot_value: upper.(column, column)
            column + 1 < size?
                (column + 1)..size - 1 >>
                    row: $
                    .factor: upper.(row, column) / pivot_value
                    lower.(row, column): factor
                    column..size - 1 >>
                        target: $
                        upper.(row, target): upper.(row, target) - factor * upper.(column, target)
    (lower:lower, upper:upper, permutation:permutation, sign:sign)

cholesky(matrix:[[num:n]:n], tolerance:num=0.000000000001) -> [[num:n]:n]:
    lower: matrix * 0
    size: matrix.length()
    total: 0
    size > 0?
        ..size - 1 >>
            row: $
            ..row >>
                column: $
                .total: matrix.(row, column)
                column > 0?
                    ..column - 1 >>
                        inner: $
                        .total-: lower.(row, inner) * lower.(column, inner)
                row = column?
                    total <= tolerance?
                        errors.ValueError("linalg.cholesky matrix is not positive definite")!
                    lower.(row, column): m.sqrt(total)
                row != column?
                    lower.(row, column): total / lower.(column, column)
    lower

qr(matrix:[[num:c]:r], tolerance:num=0.000000000001) -> (q:[[num:c]:r],r:[[num:c]:c]):
    q: matrix * 0
    r_upper: [matrix.0 >> matrix.0 * 0.0]
    vector: [matrix >> 0]
    row_count: matrix.length()
    column_count: matrix.0.length()
    total: 0
    norm: 0
    column_count > 0?
        ..column_count - 1 >>
            column: $
            .vector: [matrix >> 0]
            row_count > 0?
                ..row_count - 1 >>
                    row: $
                    vector.(row): matrix.(row, column)
            column > 0?
                ..column - 1 >>
                    prior: $
                    .total: 0
                    ..row_count - 1 >>
                        row: $
                        .total+: q.(row, prior) * vector.(row)
                    r_upper.(prior, column): total
                    ..row_count - 1 >>
                        row: $
                        vector.(row): vector.(row) - total * q.(row, prior)
            .total: 0
            ..row_count - 1 >>
                row: $
                .total+: vector.(row) * vector.(row)
            .norm: m.sqrt(total)
            norm <= tolerance?
                errors.ValueError("linalg.qr matrix has dependent columns")!
            r_upper.(column, column): norm
            ..row_count - 1 >>
                row: $
                q.(row, column): vector.(row) / norm
    (q:q, r:r_upper)

_eigen_householder_reference(
    matrix:[[num:n]:n],
    tolerance:num=0.000000000001,
    max_sweeps:num=64,
    verify_result:bit=true
) -> (
    values:[num:n],
    vectors:[[num:n]:n],
    converged:bit,
    sweeps:int,
    relative_residual:num,
    verified:bit
):
    size: matrix.length()
    size = 0?
        errors.ValueError("linalg.eigen requires a nonempty square matrix")!
    vectors: matrix * 1.0
    ..size - 1 >>
        row: $
        row + 1 < size?
            (row + 1)..size - 1 >>
                column: $
                _linalg_abs(vectors.(row, column) - vectors.(column, row)) > tolerance?
                    errors.ValueError("linalg.eigen currently requires a real symmetric matrix")!

    values: matrix.0 * 0.0
    off_diagonal: matrix.0 * 0.0
    ..size - 1 >>
        values.($): vectors.(size - 1, $)

    # Householder reduction to symmetric tridiagonal form (EISPACK TRED2).
    reduction_index: size - 1
    scale: 0
    h: 0
    f: 0
    g: 0
    half_projection: 0
    reduction_index > 0?>
        .scale: 0
        .h: 0
        ..reduction_index - 1 >>
            .scale+: _linalg_abs(values.($))
        scale = 0?
            off_diagonal.(reduction_index): values.(reduction_index - 1)
            ..reduction_index - 1 >>
                values.($): vectors.(reduction_index - 1, $)
                vectors.(reduction_index, $): 0
                vectors.($, reduction_index): 0
        scale != 0?
            ..reduction_index - 1 >>
                values.($): values.($) / scale
                .h+: values.($) * values.($)
            .f: values.(reduction_index - 1)
            .g: m.sqrt(h)
            f > 0?
                .g: -g
            off_diagonal.(reduction_index): scale * g
            .h: h - f * g
            values.(reduction_index - 1): f - g
            ..reduction_index - 1 >>
                off_diagonal.($): 0
            ..reduction_index - 1 >>
                column: $
                .f: values.(column)
                vectors.(column, reduction_index): f
                .g: off_diagonal.(column) + vectors.(column, column) * f
                column + 1 < reduction_index?
                    (column + 1)..reduction_index - 1 >>
                        row: $
                        .g+: vectors.(row, column) * values.(row)
                        off_diagonal.(row)+: vectors.(row, column) * f
                off_diagonal.(column): g
            .f: 0
            ..reduction_index - 1 >>
                off_diagonal.($): off_diagonal.($) / h
                .f+: off_diagonal.($) * values.($)
            .half_projection: f / (h + h)
            ..reduction_index - 1 >>
                off_diagonal.($)-: half_projection * values.($)
            ..reduction_index - 1 >>
                column: $
                .f: values.(column)
                .g: off_diagonal.(column)
                column..reduction_index - 1 >>
                    row: $
                    vectors.(row, column)-: (
                        f * off_diagonal.(row) + g * values.(row)
                    )
                values.(column): vectors.(reduction_index - 1, column)
                vectors.(reduction_index, column): 0
        values.(reduction_index): h
        .reduction_index-: 1

    # Accumulate the Householder transformations.
    accumulation_index: 0
    accumulation_index < size - 1?>
        vectors.(size - 1, accumulation_index): (
            vectors.(accumulation_index, accumulation_index)
        )
        vectors.(accumulation_index, accumulation_index): 1
        .h: values.(accumulation_index + 1)
        h != 0?
            ..accumulation_index >>
                values.($): vectors.($, accumulation_index + 1) / h
            ..accumulation_index >>
                column: $
                .g: 0
                ..accumulation_index >>
                    .g+: (
                        vectors.($, accumulation_index + 1) *
                        vectors.($, column)
                    )
                ..accumulation_index >>
                    vectors.($, column)-: g * values.($)
        ..accumulation_index >>
            vectors.($, accumulation_index + 1): 0
        .accumulation_index+: 1
    ..size - 1 >>
        values.($): vectors.(size - 1, $)
        vectors.(size - 1, $): 0
    vectors.(size - 1, size - 1): 1
    off_diagonal.0: 0

    # Implicit QL on the tridiagonal matrix (EISPACK TQL2).
    size > 1?
        1..size - 1 >>
            off_diagonal.($ - 1): off_diagonal.($)
    off_diagonal.(size - 1): 0
    shift: 0
    test_scale: 0
    eigen_index: 0
    sweeps: 0
    converged: true
    candidate_scale: 0
    split_index: 0
    iteration: 0
    next_index: 0
    p: 0
    radius: 0
    next_value: 0
    cosine: 1
    previous_cosine: 1
    older_cosine: 1
    sine: 0
    previous_sine: 0
    first_off_diagonal: 0
    rotation_index: 0
    selected_index: 0
    selected_value: 0
    eigen_index < size?>
        .candidate_scale: (
            _linalg_abs(values.(eigen_index)) +
            _linalg_abs(off_diagonal.(eigen_index))
        )
        candidate_scale > test_scale?
            .test_scale: candidate_scale
        .split_index: eigen_index
        split_index < size /\ (
            _linalg_abs(off_diagonal.(split_index)) >
            0.0000000000000002220446049250313 * test_scale
        )?>
            .split_index+: 1
        .iteration: 0
        (
            split_index > eigen_index /\
            _linalg_abs(off_diagonal.(eigen_index)) >
                0.0000000000000002220446049250313 * test_scale /\
            iteration < max_sweeps
        )?>
            .iteration+: 1
            .sweeps+: 1
            .next_index: eigen_index + 1
            .g: values.(eigen_index)
            .p: (
                (values.(next_index) - g) /
                (2 * off_diagonal.(eigen_index))
            )
            .radius: m.sqrt(p * p + 1)
            p < 0?
                .radius: -radius
            values.(eigen_index): (
                off_diagonal.(eigen_index) / (p + radius)
            )
            values.(next_index): (
                off_diagonal.(eigen_index) * (p + radius)
            )
            .next_value: values.(next_index)
            .h: g - values.(eigen_index)
            next_index + 1 < size?
                (next_index + 1)..size - 1 >>
                    values.($)-: h
            .shift+: h
            .p: values.(split_index)
            .cosine: 1
            .previous_cosine: 1
            .older_cosine: 1
            .sine: 0
            .previous_sine: 0
            .first_off_diagonal: off_diagonal.(next_index)
            .rotation_index: split_index - 1
            rotation_index >= eigen_index?>
                .older_cosine: previous_cosine
                .previous_cosine: cosine
                .previous_sine: sine
                .g: cosine * off_diagonal.(rotation_index)
                .h: cosine * p
                .radius: m.sqrt(
                    p * p + off_diagonal.(rotation_index) *
                    off_diagonal.(rotation_index)
                )
                off_diagonal.(rotation_index + 1): sine * radius
                .sine: off_diagonal.(rotation_index) / radius
                .cosine: p / radius
                .p: cosine * values.(rotation_index) - sine * g
                values.(rotation_index + 1): (
                    h + sine * (
                        cosine * g + sine * values.(rotation_index)
                    )
                )
                ..size - 1 >>
                    row: $
                    .h: vectors.(row, rotation_index + 1)
                    vectors.(row, rotation_index + 1): (
                        sine * vectors.(row, rotation_index) + cosine * h
                    )
                    vectors.(row, rotation_index): (
                        cosine * vectors.(row, rotation_index) - sine * h
                    )
                .rotation_index-: 1
            .p: (
                -sine * previous_sine * older_cosine *
                first_off_diagonal * off_diagonal.(eigen_index) /
                next_value
            )
            off_diagonal.(eigen_index): sine * p
            values.(eigen_index): cosine * p
        (
            split_index > eigen_index /\
            _linalg_abs(off_diagonal.(eigen_index)) >
                0.0000000000000002220446049250313 * test_scale
        )?
            .converged: false
        values.(eigen_index)+: shift
        off_diagonal.(eigen_index): 0
        .eigen_index+: 1

    # Stable ascending ordering, including corresponding eigenvectors.
    order_index: 0
    order_index < size - 1?>
        .selected_index: order_index
        .selected_value: values.(order_index)
        (order_index + 1)..size - 1 >>
            values.($) < selected_value?
                .selected_index: $
                .selected_value: values.($)
        selected_index != order_index?
            values.(selected_index): values.(order_index)
            values.(order_index): selected_value
            ..size - 1 >>
                .f: vectors.($, order_index)
                vectors.($, order_index): vectors.($, selected_index)
                vectors.($, selected_index): f
        .order_index+: 1

    maximum_relative_residual: 0
    verified: false
    verify_result?
        matrix_norm: _linalg_matrix_infinity_norm(matrix)
        ..size - 1 >>
            column: $
            vector: matrix.0 * 0.0
            ..size - 1 >>
                vector.($): vectors.($, column)
            difference: _linalg_numeric_dot(matrix, vector) - values.(column) * vector
            numerator: _linalg_vector_infinity_norm(difference)
            vector_norm: _linalg_vector_infinity_norm(vector)
            scale_for_pair: (
                matrix_norm * vector_norm +
                _linalg_abs(values.(column)) * vector_norm
            )
            pair_residual: numerator
            scale_for_pair > 0?
                .pair_residual: numerator / scale_for_pair
            pair_residual > maximum_relative_residual?
                .maximum_relative_residual: pair_residual
        .verified: converged /\ maximum_relative_residual <= tolerance * 10

    (
        values:values,
        vectors:vectors,
        converged:converged,
        sweeps:int(sweeps),
        relative_residual:maximum_relative_residual,
        verified:verified
    )

eigen(
    matrix:[[num:n]:n],
    tolerance:num=0.000000000001,
    max_sweeps:num=64,
    verify_result:bit=true
) -> (
    values:[num:n],
    vectors:[[num:n]:n],
    converged:bit,
    sweeps:int,
    relative_residual:num,
    verified:bit
):
    size: matrix.length()
    size = 0?
        errors.ValueError("linalg.eigen requires a nonempty square matrix")!
    working: matrix * 1.0
    vectors: matrix * 0.0
    ..size - 1 >>
        vectors.($, $): 1

    ..size - 1 >>
        row: $
        row + 1 < size?
            (row + 1)..size - 1 >>
                column: $
                _linalg_abs(working.(row, column) - working.(column, row)) > tolerance?
                    errors.ValueError("linalg.eigen currently requires a real symmetric matrix")!

    converged: size = 1
    sweeps: 0
    pivot_row: 0
    pivot_column: 1
    largest: 0
    diagonal_left: 0
    diagonal_right: 0
    off_diagonal: 0
    angle: 0
    cosine: 1
    sine: 0
    left_value: 0
    right_value: 0
    rotated_left: 0
    rotated_right: 0
    sweeps < max_sweeps /\ ~converged?>
        .largest: 0
        ..size - 1 >>
            .pivot_row: $
            pivot_row + 1 < size?
                (pivot_row + 1)..size - 1 >>
                    .pivot_column: $
                    .off_diagonal: working.(pivot_row, pivot_column)
                    _linalg_abs(off_diagonal) > tolerance?
                        .diagonal_left: working.(pivot_row, pivot_row)
                        .diagonal_right: working.(pivot_column, pivot_column)
                        .angle: 0.5 * m.atan2(
                            2 * off_diagonal,
                            diagonal_right - diagonal_left
                        )
                        .cosine: m.cos(angle)
                        .sine: m.sin(angle)

                        ..size - 1 >>
                            row: $
                            row != pivot_row /\ row != pivot_column?
                                .left_value: working.(row, pivot_row)
                                .right_value: working.(row, pivot_column)
                                .rotated_left: cosine * left_value - sine * right_value
                                .rotated_right: sine * left_value + cosine * right_value
                                working.(row, pivot_row): rotated_left
                                working.(pivot_row, row): rotated_left
                                working.(row, pivot_column): rotated_right
                                working.(pivot_column, row): rotated_right

                        working.(pivot_row, pivot_row): (
                            cosine * cosine * diagonal_left -
                            2 * sine * cosine * off_diagonal +
                            sine * sine * diagonal_right
                        )
                        working.(pivot_column, pivot_column): (
                            sine * sine * diagonal_left +
                            2 * sine * cosine * off_diagonal +
                            cosine * cosine * diagonal_right
                        )
                        working.(pivot_row, pivot_column): 0
                        working.(pivot_column, pivot_row): 0

                        ..size - 1 >>
                            row: $
                            .left_value: vectors.(row, pivot_row)
                            .right_value: vectors.(row, pivot_column)
                            vectors.(row, pivot_row): cosine * left_value - sine * right_value
                            vectors.(row, pivot_column): sine * left_value + cosine * right_value
        .sweeps+: 1
        .largest: 0
        ..size - 1 >>
            row: $
            row + 1 < size?
                (row + 1)..size - 1 >>
                    magnitude: _linalg_abs(working.(row, $))
                    magnitude > largest?
                        .largest: magnitude
        .converged: largest <= tolerance

    values: matrix.0 * 0.0
    ..size - 1 >>
        values.($): working.($, $)

    maximum_relative_residual: 0
    verified: false
    verify_result?
        matrix_norm: _linalg_matrix_infinity_norm(matrix)
        ..size - 1 >>
            column: $
            vector: matrix.0 * 0.0
            ..size - 1 >>
                vector.($): vectors.($, column)
            difference: _linalg_numeric_dot(matrix, vector) - values.(column) * vector
            numerator: _linalg_vector_infinity_norm(difference)
            vector_norm: _linalg_vector_infinity_norm(vector)
            scale: matrix_norm * vector_norm + _linalg_abs(values.(column)) * vector_norm
            pair_residual: numerator
            scale > 0?
                .pair_residual: numerator / scale
            pair_residual > maximum_relative_residual?
                .maximum_relative_residual: pair_residual
        .verified: converged /\ maximum_relative_residual <= tolerance * 10

    (
        values:values,
        vectors:vectors,
        converged:converged,
        sweeps:int(sweeps),
        relative_residual:maximum_relative_residual,
        verified:verified
    )

svd(
    matrix:[[num:c]:r],
    tolerance:num=0.000000000001,
    max_sweeps:num=64,
    verify_result:bit=true
) -> (
    u:[[num:c]:r],
    s:[num:c],
    vh:[[num:c]:c],
    converged:bit,
    relative_residual:num,
    orthogonality_residual:num,
    verified:bit
):
    row_count: matrix.length()
    row_count = 0?
        errors.ValueError("linalg.svd requires a nonempty matrix")!
    column_count: matrix.0.length()
    column_count = 0?
        errors.ValueError("linalg.svd requires at least one column")!
    row_count < column_count?
        errors.ValueError("linalg.svd thin factorization requires rows >= columns")!
    size: column_count

    [[num:c]:c] gram: [matrix.0 >> matrix.0 * 0.0]
    gram_total: 0
    ..size - 1 >>
        left_column: $
        ..size - 1 >>
            right_column: $
            .gram_total: 0
            ..row_count - 1 >>
                row: $
                .gram_total+: (
                    matrix.(row, left_column) * matrix.(row, right_column)
                )
            gram.(left_column, right_column): gram_total

    spectral: eigen(gram, tolerance, max_sweeps, verify_result)
    singular_values: matrix.0 * 0.0
    [[num:c]:c] right_vectors: gram * 0.0
    used: matrix.0 * 0.0
    best_source: 0
    best_value: 0
    selected_value: 0
    ..size - 1 >>
        target: $
        .best_source: 0
        .best_value: -1
        ..size - 1 >>
            candidate: $
            used.(candidate) = 0 /\ spectral.values.(candidate) > best_value?
                .best_source: candidate
                .best_value: spectral.values.(candidate)
        used.(best_source): 1
        .selected_value: best_value
        selected_value < 0 /\ _linalg_abs(selected_value) <= tolerance?
            .selected_value: 0
        selected_value < 0?
            errors.ValueError("linalg.svd encountered a negative Gram eigenvalue")!
        singular_values.(target): m.sqrt(selected_value)
        ..size - 1 >>
            row: $
            right_vectors.(row, target): spectral.vectors.(row, best_source)

    [[num:c]:r] left_vectors: matrix * 0.0
    ..size - 1 >>
        column: $
        right_vector: matrix.0 * 0.0
        ..size - 1 >>
            right_vector.($): right_vectors.($, column)
        [num:r] transformed: _linalg_numeric_dot(matrix, right_vector)
        singular_values.(column) > tolerance?
            ..row_count - 1 >>
                left_vectors.($, column): transformed.($) / singular_values.(column)

    basis_candidate: [matrix >> 0.0]
    basis_index: 0
    candidate_norm: 0
    projection: 0
    found_basis: false
    ..size - 1 >>
        column: $
        singular_values.(column) <= tolerance?
            .basis_index: 0
            .found_basis: false
            basis_index < row_count /\ ~found_basis?>
                .basis_candidate: [matrix >> 0.0]
                basis_candidate.(basis_index): 1
                column > 0?
                    ..column - 1 >>
                        prior: $
                        .projection: 0
                        ..row_count - 1 >>
                            row: $
                            .projection+: (
                                left_vectors.(row, prior) * basis_candidate.(row)
                            )
                        ..row_count - 1 >>
                            row: $
                            basis_candidate.(row): (
                                basis_candidate.(row) -
                                projection * left_vectors.(row, prior)
                            )
                .candidate_norm: m.sqrt(_linalg_numeric_dot(
                    basis_candidate,
                    basis_candidate
                ))
                candidate_norm > tolerance?
                    ..row_count - 1 >>
                        left_vectors.($, column): basis_candidate.($) / candidate_norm
                    .found_basis: true
                .basis_index+: 1
            ~found_basis?
                errors.RuntimeError("linalg.svd could not complete the left singular basis")!

    [[num:c]:c] right_adjoint: gram * 0.0
    ..size - 1 >>
        row: $
        ..size - 1 >>
            right_adjoint.(row, $): right_vectors.($, row)

    measured_residual: 0
    orthogonality_residual: 0
    verified: false
    reconstruction_total: 0
    numerator: 0
    scale: 0
    error_row_sum: 0
    matrix_row_sum: 0
    left_orthogonality: 0
    right_orthogonality: 0
    left_total: 0
    right_total: 0
    expected: 0
    orthogonality_error: 0
    [[num:c]:r] reconstructed: matrix * 0.0
    [[num:c]:r] reconstruction_error: matrix * 0.0
    verify_result?
        ..row_count - 1 >>
            row: $
            ..size - 1 >>
                column: $
                .reconstruction_total: 0
                ..size - 1 >>
                    inner: $
                    .reconstruction_total+: (
                        left_vectors.(row, inner) * singular_values.(inner) *
                        right_adjoint.(inner, column)
                    )
                reconstructed.(row, column): reconstruction_total
        .reconstruction_error: reconstructed - matrix
        ..row_count - 1 >>
            row: $
            .error_row_sum: 0
            .matrix_row_sum: 0
            ..size - 1 >>
                column: $
                .error_row_sum+: _linalg_abs(reconstruction_error.(row, column))
                .matrix_row_sum+: _linalg_abs(matrix.(row, column))
            error_row_sum > numerator?
                .numerator: error_row_sum
            matrix_row_sum > scale?
                .scale: matrix_row_sum
        .measured_residual: numerator
        scale > 0?
            .measured_residual: numerator / scale

        ..size - 1 >>
            first: $
            ..size - 1 >>
                second: $
                .left_total: 0
                ..row_count - 1 >>
                    component: $
                    .left_total+: (
                        left_vectors.(component, first) *
                        left_vectors.(component, second)
                    )
                .right_total: 0
                ..size - 1 >>
                    component: $
                    .right_total+: (
                        right_adjoint.(first, component) *
                        right_adjoint.(second, component)
                    )
                .expected: 0
                first = second?
                    .expected: 1
                .orthogonality_error: _linalg_abs(left_total - expected)
                orthogonality_error > left_orthogonality?
                    .left_orthogonality: orthogonality_error
                .orthogonality_error: _linalg_abs(right_total - expected)
                orthogonality_error > right_orthogonality?
                    .right_orthogonality: orthogonality_error
        .orthogonality_residual: left_orthogonality
        right_orthogonality > orthogonality_residual?
            .orthogonality_residual: right_orthogonality
        .verified: (
            spectral.converged /\ spectral.verified /\
            measured_residual <= tolerance * 10 /\
            orthogonality_residual <= tolerance * 100
        )
    (
        u:left_vectors,
        s:singular_values,
        vh:right_adjoint,
        converged:spectral.converged,
        relative_residual:measured_residual,
        orthogonality_residual:orthogonality_residual,
        verified:verified
    )

least_squares(
    matrix:[[num:c]:r],
    values:[num:r],
    tolerance:num=0.000000000001
) -> [num:c]:
    matrix.length() < matrix.0.length()?
        errors.ValueError("linalg.least_squares requires rows >= columns")!
    factors: qr(matrix, tolerance)
    projected: _linalg_numeric_dot(transpose(factors.q), values)
    solve(factors.r, projected, tolerance)

null_space(
    matrix:[[num:c]:r],
    tolerance:num=0.000000000001
) -> (dimension:int,basis:[[num:c]:c]):
    reduced: rref(matrix, tolerance)
    row_count: matrix.length()
    column_count: matrix.0.length()
    pivot_for_row: [matrix >> -1.0]
    is_pivot: matrix.0 * 0
    basis: matmul(transpose(matrix), matrix) * 0.0
    found: false
    pivot: 0
    row_count > 0?
        ..row_count - 1 >>
            row: $
            .found: false
            column_count > 0?
                ..column_count - 1 >>
                    column: $
                    found = false?
                        _linalg_abs(reduced.(row, column)) > tolerance?
                            pivot_for_row.(row): column
                            is_pivot.(column): 1
                            .found: true
    dimension: 0
    column_count > 0?
        ..column_count - 1 >>
            free_column: $
            is_pivot.(free_column) = 0?
                basis.(dimension, free_column): 1
                row_count > 0?
                    ..row_count - 1 >>
                        row: $
                        .pivot: pivot_for_row.(row)
                        pivot >= 0?
                            basis.(dimension, pivot): 0 - reduced.(row, free_column)
                .dimension+: 1
    (dimension:dimension, basis:basis)

_rref_system(
    matrix:[[num:c]:r],
    values:[num:r],
    tolerance:num
) -> (matrix:[[num:c]:r],values:[num:r]):
    working: matrix * 1.0
    right: values * 1.0
    row_count: matrix.length()
    column_count: matrix.0.length()
    pivot_row: 0
    pivot: 0
    pivot_magnitude: 0
    candidate_magnitude: 0
    pivot_value: 0
    factor: 0
    temporary_value: 0
    temporary_right: 0
    column_count > 0?
        ..column_count - 1 >>
            column: $
            pivot_row < row_count?
                .pivot: pivot_row
                .pivot_magnitude: _linalg_abs(working.(pivot_row, column))
                pivot_row + 1 < row_count?
                    (pivot_row + 1)..row_count - 1 >>
                        candidate: $
                        .candidate_magnitude: _linalg_abs(working.(candidate, column))
                        candidate_magnitude > pivot_magnitude?
                            .pivot: candidate
                            .pivot_magnitude: candidate_magnitude
                pivot_magnitude > tolerance?
                    pivot != pivot_row?
                        ..column_count - 1 >>
                            swap_column: $
                            .temporary_value: working.(pivot, swap_column)
                            working.(pivot, swap_column): working.(pivot_row, swap_column)
                            working.(pivot_row, swap_column): temporary_value
                        .temporary_right: right.(pivot)
                        right.(pivot): right.(pivot_row)
                        right.(pivot_row): temporary_right
                    .pivot_value: working.(pivot_row, column)
                    ..column_count - 1 >>
                        target: $
                        working.(pivot_row, target): working.(pivot_row, target) / pivot_value
                    right.(pivot_row): right.(pivot_row) / pivot_value
                    ..row_count - 1 >>
                        row: $
                        row != pivot_row?
                            .factor: working.(row, column)
                            _linalg_abs(factor) > tolerance?
                                ..column_count - 1 >>
                                    target: $
                                    working.(row, target): working.(row, target) - factor * working.(pivot_row, target)
                                right.(row): right.(row) - factor * right.(pivot_row)
                    .pivot_row+: 1
    (matrix:working, values:right)

solution_space(
    matrix:[[num:c]:r],
    values:[num:r],
    tolerance:num=0.000000000001
) -> (
    consistent:bit,
    unique:bit,
    rank:int,
    nullity:int,
    particular:[num:c],
    directions:[[num:c]:c]
):
    reduced_system: _rref_system(matrix, values, tolerance)
    reduced: reduced_system.matrix
    right: reduced_system.values
    kernel: null_space(matrix, tolerance)
    row_count: matrix.length()
    column_count: matrix.0.length()
    particular: matrix.0 * 0
    consistent: true
    row_nonzero: false
    pivot_found: false
    pivot: 0
    row_count > 0?
        ..row_count - 1 >>
            row: $
            .row_nonzero: false
            .pivot_found: false
            column_count > 0?
                ..column_count - 1 >>
                    column: $
                    _linalg_abs(reduced.(row, column)) > tolerance?
                        .row_nonzero: true
                        pivot_found = false?
                            .pivot: column
                            .pivot_found: true
            row_nonzero?
                particular.(pivot): right.(row)
            row_nonzero = false?
                _linalg_abs(right.(row)) > tolerance?
                    .consistent: false
    solution_rank: column_count - kernel.dimension
    unique: consistent /\ kernel.dimension = 0
    (
        consistent:consistent,
        unique:unique,
        rank:solution_rank,
        nullity:kernel.dimension,
        particular:particular,
        directions:kernel.basis
    )

residual(
    matrix:[[num:c]:r],
    values:[num:c],
    targets:[num:r]
) -> [num:r]:
    _linalg_numeric_dot(matrix, values) - targets

_linalg_vector_infinity_norm(values:[num:n]) -> num:
    result: 0
    values.length() > 0?
        ..values.length() - 1 >>
            magnitude: _linalg_abs(values.($))
            magnitude > result?
                .result: magnitude
    result

_linalg_matrix_infinity_norm(matrix:[[num:c]:r]) -> num:
    result: 0
    row_sum: 0
    matrix.length() > 0?
        ..matrix.length() - 1 >>
            row: $
            .row_sum: 0
            matrix.0.length() > 0?
                ..matrix.0.length() - 1 >>
                    .row_sum+: _linalg_abs(matrix.(row, $))
            row_sum > result?
                .result: row_sum
    result

condition_number(
    matrix:[[num:n]:n],
    tolerance:num=0.000000000001
) -> num:
    (
        _linalg_matrix_infinity_norm(matrix) *
        _linalg_matrix_infinity_norm(inverse(matrix, tolerance))
    )

relative_residual(
    matrix:[[num:c]:r],
    values:[num:c],
    targets:[num:r]
) -> num:
    difference: residual(matrix, values, targets)
    numerator: _linalg_vector_infinity_norm(difference)
    scale: (
        _linalg_matrix_infinity_norm(matrix) *
        _linalg_vector_infinity_norm(values) +
        _linalg_vector_infinity_norm(targets)
    )
    scale = 0? @: numerator
    numerator / scale

verify_solution(
    matrix:[[num:n]:n],
    values:[num:n],
    targets:[num:n],
    tolerance:num=0.000000001,
    condition_limit:num=1000000000000
):
    measured_residual: relative_residual(matrix, values, targets)
    measured_condition: condition_number(matrix)
    (
        valid:measured_residual <= tolerance /\ measured_condition <= condition_limit,
        relative_residual:measured_residual,
        condition_number:measured_condition,
        forward_error_bound:measured_condition * measured_residual
    )
# Mathematical constants and composed functions owned by VKF source.
# Elementary scalar primitives such as sin/cos/exp are compiler/runtime ABI
# operations; compositions remain ordinary inspectable VKF.

pi: 3.141592653589793
e: 2.718281828459045
tau: 6.283185307179586

tan(value:num) -> num:
    math.sin(value) / math.cos(value)

sec(value:num) -> num:
    1 / math.cos(value)

cot(value:num) -> num:
    math.cos(value) / math.sin(value)

csc(value:num) -> num:
    1 / math.sin(value)

sinh(value:num) -> num:
    (math.exp(value) - math.exp(-value)) / 2

cosh(value:num) -> num:
    (math.exp(value) + math.exp(-value)) / 2

tanh(value:num) -> num:
    sinh(value) / cosh(value)

lg(value:num) -> num:
    math.ln(value) / math.ln(10)

lg2(value:num) -> num:
    math.ln(value) / math.ln(2)

log(value:num, base:num) -> num:
    (base > 0 /\ base != 1)?! "math.log: base must be positive and not 1"
    (value > 0)?! "math.log: value must be positive"
    math.ln(value) / math.ln(base)

asinh(value:num) -> num:
    math.ln(value + math.sqrt(value * value + 1))

acosh(value:num) -> num:
    (value >= 1)?! "math.acosh: real input must be at least 1"
    math.ln(value + math.sqrt(value * value - 1))

atanh(value:num) -> num:
    (value > -1 /\ value < 1)?! "math.atanh: real input must be between -1 and 1"
    math.ln((1 + value) / (1 - value)) / 2

# Range-reduced Gregory series. The reduction keeps |z| <= tan(pi/8), so
# sixteen terms provide substantially better than f64 display precision here.
atan(value:num) -> num:
    negative: value < 0
    magnitude: math.abs(value)
    inverted: magnitude > 1
    z: magnitude
    inverted?
        .z: 1 / z
    offset: 0
    z > 0.41421356237309503?
        .z: (z - 1) / (z + 1)
        .offset: pi / 4
    z_squared: z * z
    term: z
    series: z
    i: 1
    i < 16?>
        .term: 0 - term * z_squared
        .series: series + term / (2 * i + 1)
        .i: i + 1
    result: offset + series
    inverted?
        .result: pi / 2 - result
    negative?
        .result: 0 - result
    result

atan2(y:num, x:num) -> num:
    x > 0? @: atan(y / x)
    x < 0 /\ y >= 0? @: atan(y / x) + pi
    x < 0 /\ y < 0? @: atan(y / x) - pi
    y > 0? @: pi / 2
    y < 0? @: 0 - pi / 2
    0

asin(value:num) -> num:
    (value >= -1 /\ value <= 1)?! "math.asin: real input must be in [-1, 1]"
    atan2(value, math.sqrt(1 - value * value))

acos(value:num) -> num:
    (value >= -1 /\ value <= 1)?! "math.acos: real input must be in [-1, 1]"
    atan2(math.sqrt(1 - value * value), value)

acot(value:num) -> num:
    value = 0? @: pi / 2
    atan(1 / value)

asec(value:num) -> num:
    (math.abs(value) >= 1)?! "math.asec: real input magnitude must be at least 1"
    acos(1 / value)

acsc(value:num) -> num:
    (math.abs(value) >= 1)?! "math.acsc: real input magnitude must be at least 1"
    asin(1 / value)

# Lanczos approximation (g=7), with reflection for the negative real branch.
gamma(value:num) -> num:
    value < 0.5? @: pi / (math.sin(pi * value) * gamma(1 - value))
    z: value - 1
    coefficients: [
        0.99999999999980993,
        676.5203681218851,
        -1259.1392167224028,
        771.32342877765313,
        -176.61502916214059,
        12.507343278686905,
        -0.13857109526572012,
        0.0000099843695780195716,
        0.00000015056327351493116
    ]
    estimate: coefficients.0
    i: 1
    i < 9?>
        .estimate: estimate + coefficients.(i) / (z + i)
        .i: i + 1
    t: z + 7.5
    math.sqrt(2 * pi) * (t ^ (z + 0.5)) * math.exp(0 - t) * estimate

# Abramowitz-Stegun 7.1.26. Maximum absolute error is about 1.5e-7.
erf(value:num) -> num:
    value = 0? @: 0
    sign_value: 1
    value < 0?
        .sign_value: -1
    x: math.abs(value)
    t: 1 / (1 + 0.3275911 * x)
    polynomial: (((((1.061405429 * t - 1.453152027) * t) + 1.421413741) * t - 0.284496736) * t + 0.254829592) * t
    sign_value * (1 - polynomial * math.exp(0 - x * x))
# Physics stdlib fixture.
#
# Rigid-body collision helpers are expressed in VKF so the scene/runtime can
# compile the same source on web, desktop, and mobile hosts.

:.math
:.linalg
errors: .errors

Vector3: [num:3]
Matrix3: [[num:3]:3]
RigidMaterial: (
    name:str,
    density:num,
    e_n:num,
    e_t:num,
    mu_s:num,
    mu_d:num,
    mu_r:num,
    restitution_threshold:num,
    normal_restitution:num,
    tangent_restitution:num,
    static_friction:num,
    dynamic_friction:num,
    rolling_friction:num
)
ContactMaterial: (
    e_n:num,
    e_t:num,
    mu_s:num,
    mu_d:num,
    mu_r:num,
    restitution_threshold:num,
    normal_restitution:num,
    tangent_restitution:num,
    static_friction:num,
    dynamic_friction:num,
    rolling_friction:num
)

contact_static: 0
contact_dynamic: 1
contact_degenerate: 2

# Rigid-body mass properties and inertial stepping are part of physics. There
# is no separate `rigid_body` release module.

rb_add3(a:any, b:any):
    [a.0 + b.0, a.1 + b.1, a.2 + b.2]

rb_sub3(a:any, b:any):
    [a.0 - b.0, a.1 - b.1, a.2 - b.2]

rb_scale3(s:num, v:any):
    [s * v.0, s * v.1, s * v.2]

rb_dot3(a:[num:3], b:[num:3]) -> num:
    dot(a, b)

rb_cross3(a:[num:3], b:[num:3]) -> [num:3]:
    cross(a, b)

rb_mat3(
    a00:num, a01:num, a02:num,
    a10:num, a11:num, a12:num,
    a20:num, a21:num, a22:num
):
    [
        [a00, a01, a02],
        [a10, a11, a12],
        [a20, a21, a22]
    ]

rb_identity3():
    rb_mat3(1, 0, 0, 0, 1, 0, 0, 0, 1)

rb_scale_mat3(s:num, A:any):
    rb_mat3(
        s * A.(0, 0), s * A.(0, 1), s * A.(0, 2),
        s * A.(1, 0), s * A.(1, 1), s * A.(1, 2),
        s * A.(2, 0), s * A.(2, 1), s * A.(2, 2)
    )

rb_add_mat3(A:any, B:any):
    rb_mat3(
        A.(0, 0) + B.(0, 0), A.(0, 1) + B.(0, 1), A.(0, 2) + B.(0, 2),
        A.(1, 0) + B.(1, 0), A.(1, 1) + B.(1, 1), A.(1, 2) + B.(1, 2),
        A.(2, 0) + B.(2, 0), A.(2, 1) + B.(2, 1), A.(2, 2) + B.(2, 2)
    )

rb_outer3(a:[num:3], b:[num:3]) -> [[num:3]:3]:
    rb_mat3(
        a.0 * b.0, a.0 * b.1, a.0 * b.2,
        a.1 * b.0, a.1 * b.1, a.1 * b.2,
        a.2 * b.0, a.2 * b.1, a.2 * b.2
    )

rb_trace3(A:[[num:3]:3]) -> num:
    trace(A)

rb_det3(A:[[num:3]:3]) -> num:
    determinant(A)

rb_inverse3(A:[[num:3]:3]) -> [[num:3]:3]:
    inverse(A)

rb_mat_vec3(A:[[num:3]:3], v:[num:3]) -> [num:3]:
    [
        A.(0, 0) * v.0 + A.(0, 1) * v.1 + A.(0, 2) * v.2,
        A.(1, 0) * v.0 + A.(1, 1) * v.1 + A.(1, 2) * v.2,
        A.(2, 0) * v.0 + A.(2, 1) * v.1 + A.(2, 2) * v.2
    ]

rb_abs(x:num):
    x < 0? @: 0 - x
    @: x

parallel_axis_shift3(mass:num, displacement:any):
    d2: rb_dot3(displacement, displacement)
    rb_add_mat3(
        rb_scale_mat3(mass * d2, rb_identity3()),
        rb_scale_mat3(0 - mass, rb_outer3(displacement, displacement))
    )

tetra_mass_properties3(a:any, b:any, c:any, d:any, density:num):
    signed_six_volume: rb_dot3(rb_sub3(b, a), rb_cross3(rb_sub3(c, a), rb_sub3(d, a)))
    volume: rb_abs(signed_six_volume) / 6
    mass: volume * density
    center: rb_scale3(0.25, rb_add3(rb_add3(a, b), rb_add3(c, d)))
    summed: rb_add3(rb_add3(a, b), rb_add3(c, d))
    point_moments: rb_add_mat3(
        rb_add_mat3(rb_outer3(a, a), rb_outer3(b, b)),
        rb_add_mat3(rb_outer3(c, c), rb_outer3(d, d))
    )
    second_moment: rb_scale_mat3(
        volume / 20,
        rb_add_mat3(point_moments, rb_outer3(summed, summed))
    )
    scaled_second_moment: rb_scale_mat3(density, second_moment)
    inertia_origin: rb_add_mat3(
        rb_scale_mat3(rb_trace3(scaled_second_moment), rb_identity3()),
        rb_scale_mat3(0 - 1, scaled_second_moment)
    )
    inertia_tensor: rb_add_mat3(
        inertia_origin,
        rb_scale_mat3(0 - 1, parallel_axis_shift3(mass, center))
    )
    @: (
        mass: mass,
        volume: volume,
        center_of_mass: center,
        inertia_tensor: inertia_tensor
    )

combine_mass_properties3(a:any, b:any):
    mass: a.mass + b.mass
    center: rb_scale3(
        1 / mass,
        rb_add3(rb_scale3(a.mass, a.center_of_mass), rb_scale3(b.mass, b.center_of_mass))
    )
    inertia: rb_add_mat3(
        rb_add_mat3(a.inertia_tensor, parallel_axis_shift3(a.mass, rb_sub3(a.center_of_mass, center))),
        rb_add_mat3(b.inertia_tensor, parallel_axis_shift3(b.mass, rb_sub3(b.center_of_mass, center)))
    )
    @: (mass: mass, center_of_mass: center, inertia_tensor: inertia)

rigid_state3(position:[num:3], momentum:[num:3], angular_momentum:[num:3]):
    @: (position: position, momentum: momentum, angular_momentum: angular_momentum)

force_at_point3(force:any, point:any, center_world:any):
    torque: rb_cross3(rb_sub3(point, center_world), force)
    @: (force: force, torque: torque)

step_rigid_body_momentum3(
    state:(position:[num:3], momentum:[num:3], angular_momentum:[num:3]),
    properties:(mass:num, inertia_tensor:[[num:3]:3]),
    dt:num,
    force:[num:3],
    torque:[num:3]
):
    momentum: rb_add3(state.momentum, rb_scale3(dt, force))
    angular_momentum: rb_add3(state.angular_momentum, rb_scale3(dt, torque))
    velocity: rb_scale3(1 / properties.mass, momentum)
    angular_velocity: solve(properties.inertia_tensor, angular_momentum)
    position: rb_add3(state.position, rb_scale3(dt, velocity))
    @: (
        momentum: momentum,
        angular_momentum: angular_momentum,
        velocity: velocity,
        angular_velocity: angular_velocity,
        position: position
    )

vec2(x:num, y:num):
    [x, y]

vec3(x:num, y:num, z:num):
    [x, y, z]

add2(a:any, b:any):
    [a.0 + b.0, a.1 + b.1]

add3(a:any, b:any):
    [a.0 + b.0, a.1 + b.1, a.2 + b.2]

sub2(a:any, b:any):
    [a.0 - b.0, a.1 - b.1]

sub3(a:any, b:any):
    [a.0 - b.0, a.1 - b.1, a.2 - b.2]

scale2(s:num, v:any):
    [s * v.0, s * v.1]

scale3(s:num, v:any):
    [s * v.0, s * v.1, s * v.2]

dot2(a:[num:2], b:[num:2]) -> num:
    dot(a, b)

dot3(a:[num:3], b:[num:3]) -> num:
    dot(a, b)

cross3(a:[num:3], b:[num:3]) -> [num:3]:
    cross(a, b)

mat2(a00:num, a01:num, a10:num, a11:num):
    [[a00, a01], [a10, a11]]

mat3(
    a00:num, a01:num, a02:num,
    a10:num, a11:num, a12:num,
    a20:num, a21:num, a22:num
):
    [
        [a00, a01, a02],
        [a10, a11, a12],
        [a20, a21, a22]
    ]

zero3x3():
    mat3(0, 0, 0, 0, 0, 0, 0, 0, 0)

identity3x3():
    mat3(1, 0, 0, 0, 1, 0, 0, 0, 1)

scale_mat3(s:num, A:any):
    mat3(
        s * A.(0, 0), s * A.(0, 1), s * A.(0, 2),
        s * A.(1, 0), s * A.(1, 1), s * A.(1, 2),
        s * A.(2, 0), s * A.(2, 1), s * A.(2, 2)
    )

add_mat3(A:any, B:any):
    mat3(
        A.(0, 0) + B.(0, 0), A.(0, 1) + B.(0, 1), A.(0, 2) + B.(0, 2),
        A.(1, 0) + B.(1, 0), A.(1, 1) + B.(1, 1), A.(1, 2) + B.(1, 2),
        A.(2, 0) + B.(2, 0), A.(2, 1) + B.(2, 1), A.(2, 2) + B.(2, 2)
    )

neg_mat3(A:any):
    scale_mat3(0 - 1, A)

mat_vec3(A:[[num:3]:3], v:[num:3]) -> [num:3]:
    [
        A.(0, 0) * v.0 + A.(0, 1) * v.1 + A.(0, 2) * v.2,
        A.(1, 0) * v.0 + A.(1, 1) * v.1 + A.(1, 2) * v.2,
        A.(2, 0) * v.0 + A.(2, 1) * v.1 + A.(2, 2) * v.2
    ]

mat_mul3(A:[[num:3]:3], B:[[num:3]:3]) -> [[num:3]:3]:
    matmul(A, B)

diag_inv3(diagonal:any):
    rb_inverse3(
        mat3(
            diagonal.0, 0, 0,
            0, diagonal.1, 0,
            0, 0, diagonal.2
        )
    )

skew3(r:any):
    mat3(
        0, 0 - r.2, r.1,
        r.2, 0, 0 - r.0,
        0 - r.1, r.0, 0
    )

collision_body3(mass:num, inv_inertia:[[num:3]:3], contact_offset:[num:3]):
    mass <= 0?
        errors.ValueError("physics collision body mass must be positive")!
    inv_mass: 1 / mass
    @: (mass: mass, inv_mass: inv_mass, inv_inertia: inv_inertia, contact_offset: contact_offset)

collision_body_inverse3(inv_mass:num, inv_inertia:[[num:3]:3], contact_offset:[num:3]):
    @: (
        mass: "derived_from_inverse",
        inv_mass: inv_mass,
        inv_inertia: inv_inertia,
        contact_offset: contact_offset
    )

body_inv_mass3(body:any):
    scale_mat3(body.inv_mass, identity3x3())

body_pp3(body:any):
    S: skew3(body.contact_offset)
    # inv(m)I - S inv(I) S equals inv(m)I + [r]x inv(I) [r]x^T.
    add_mat3(body_inv_mass3(body), neg_mat3(mat_mul3(mat_mul3(S, body.inv_inertia), S)))

body_pL3(body:any):
    neg_mat3(mat_mul3(skew3(body.contact_offset), body.inv_inertia))

body_Lp3(body:any):
    mat_mul3(body.inv_inertia, skew3(body.contact_offset))

body_LL3(body:any):
    body.inv_inertia

collision_matrix3(body_a:any, body_b:any):
    pp: add_mat3(body_pp3(body_a), body_pp3(body_b))
    pL: add_mat3(body_pL3(body_a), body_pL3(body_b))
    Lp: add_mat3(body_Lp3(body_a), body_Lp3(body_b))
    LL: add_mat3(body_LL3(body_a), body_LL3(body_b))
    @: (pp: pp, pL: pL, Lp: Lp, LL: LL)

apply_collision_matrix3(matrix:any, linear_impulse:any, angular_impulse:any):
    linear_delta: add3(mat_vec3(matrix.pp, linear_impulse), mat_vec3(matrix.pL, angular_impulse))
    angular_delta: add3(mat_vec3(matrix.Lp, linear_impulse), mat_vec3(matrix.LL, angular_impulse))
    @: (linear_delta: linear_delta, angular_delta: angular_delta)

normal_restitution_impulse3(matrix:any, relative_velocity:any, normal:any, restitution:num):
    effective_mass: dot3(normal, mat_vec3(matrix.pp, normal))
    closing_speed: dot3(relative_velocity, normal)
    abs_num(effective_mass) < 0.000000000001?
        @: (magnitude: 0, impulse: [0, 0, 0])
    magnitude: (0 - (1 + restitution) * closing_speed) / effective_mass
    impulse: scale3(magnitude, normal)
    @: (magnitude: magnitude, impulse: impulse)

abs_num(x:num):
    x < 0? @: 0 - x
    @: x

clamp_num(x:num, lo:num, hi:num):
    x < lo? @: lo
    x > hi? @: hi
    @: x

max_num(a:num, b:num):
    (a + b + abs_num(a - b)) / 2

length3(v:any):
    sqrt(dot3(v, v))

unit_or_zero3(v:any):
    len: length3(v)
    len < 0.000001? @: [0, 0, 0]
    @: scale3(1 / len, v)

project_normal3(v:any, normal:any):
    scale3(dot3(v, normal), normal)

project_tangent3(v:any, normal:any):
    sub3(v, project_normal3(v, normal))

tangential_friction_impulse3(matrix:any, relative_velocity:any, normal:any, normal_impulse_magnitude:num, contact:any):
    tangent_velocity: project_tangent3(relative_velocity, normal)
    tangent_speed: length3(tangent_velocity)
    tangent_speed < 0.000001?
        @: (mode: contact_static, impulse: [0, 0, 0], speed: 0)
    tangent: scale3(1 / tangent_speed, tangent_velocity)
    effective_mass: dot3(tangent, mat_vec3(matrix.pp, tangent))
    abs_num(effective_mass) < 0.000000000001?
        @: (mode: contact_static, impulse: [0, 0, 0], speed: tangent_speed)
    desired_magnitude: (0 - (1 + contact.e_t) * tangent_speed) / effective_mass
    static_limit: contact.mu_s * abs_num(normal_impulse_magnitude)
    dynamic_limit: contact.mu_d * abs_num(normal_impulse_magnitude)
    desired_abs: abs_num(desired_magnitude)
    mode: contact_static
    limited_magnitude: desired_magnitude
    desired_abs > static_limit?
        .mode: contact_dynamic
        .limited_magnitude: clamp_num(desired_magnitude, 0 - dynamic_limit, dynamic_limit)
    impulse: scale3(limited_magnitude, tangent)
    speed: tangent_speed
    @: (mode: mode, impulse: impulse, speed: speed)

normal_contact_impulse3(matrix:any, relative_velocity:any, normal:any, contact:any):
    effective_mass: dot3(normal, mat_vec3(matrix.pp, normal))
    closing_speed: dot3(relative_velocity, normal)
    abs_num(effective_mass) < 0.000000000001?
        @: (impact: false, restitution: 0, desired_magnitude: 0, magnitude: 0, impulse: [0, 0, 0])
    impact: closing_speed < 0 - contact.restitution_threshold
    restitution: 0
    impact?
        .restitution: contact.e_n
    desired_magnitude: (0 - (1 + restitution) * closing_speed) / effective_mass
    magnitude: max_num(0, desired_magnitude)
    impulse: scale3(magnitude, normal)
    @: (
        impact: impact,
        restitution: restitution,
        desired_magnitude: desired_magnitude,
        magnitude: magnitude,
        impulse: impulse
    )

rolling_resistance_impulse3(
    matrix:any,
    relative_angular_velocity:any,
    normal:any,
    normal_impulse_magnitude:num,
    contact_radius:num,
    contact:any
):
    rolling_velocity: project_tangent3(relative_angular_velocity, normal)
    rolling_speed: length3(rolling_velocity)
    rolling_axis: unit_or_zero3(rolling_velocity)
    effective_mass: dot3(rolling_axis, mat_vec3(matrix.LL, rolling_axis)) + 0.000001
    desired_magnitude: (0 - rolling_speed) / effective_mass
    limit: contact.mu_r * contact_radius * abs_num(normal_impulse_magnitude)
    limited_magnitude: clamp_num(desired_magnitude, 0 - limit, limit)
    mode: contact_static
    abs_num(desired_magnitude) > limit?
        .mode: contact_dynamic
    impulse: scale3(limited_magnitude, rolling_axis)
    speed: rolling_speed
    @: (mode: mode, impulse: impulse, speed: speed)

spin_friction_impulse3(
    matrix:any,
    relative_angular_velocity:any,
    normal:any,
    normal_impulse_magnitude:num,
    contact_radius:num,
    contact:any
):
    spin_speed: dot3(relative_angular_velocity, normal)
    effective_mass: dot3(normal, mat_vec3(matrix.LL, normal)) + 0.000001
    desired_magnitude: (0 - spin_speed) / effective_mass
    static_limit: contact.mu_s * contact_radius * abs_num(normal_impulse_magnitude)
    dynamic_limit: contact.mu_d * contact_radius * abs_num(normal_impulse_magnitude)
    limited_magnitude: desired_magnitude
    mode: contact_static
    abs_num(desired_magnitude) > static_limit?
        .limited_magnitude: clamp_num(desired_magnitude, 0 - dynamic_limit, dynamic_limit)
        .mode: contact_dynamic
    impulse: scale3(limited_magnitude, normal)
    speed: spin_speed
    @: (mode: mode, impulse: impulse, speed: speed)

coupled_contact_impulse3(
    matrix:any,
    relative_velocity:any,
    relative_angular_velocity:any,
    normal:any,
    tangent:any,
    rolling_axis:any,
    normal_impulse_magnitude:num,
    rolling_impulse_magnitude:num,
    contact_radius:num,
    contact:any
):
    normal_impulse: scale3(normal_impulse_magnitude, normal)
    rolling_impulse: scale3(rolling_impulse_magnitude, rolling_axis)
    normal_delta: apply_collision_matrix3(matrix, normal_impulse, rolling_impulse)
    velocity_after_normal: add3(relative_velocity, normal_delta.linear_delta)
    angular_after_normal: add3(relative_angular_velocity, normal_delta.angular_delta)
    a: dot3(tangent, mat_vec3(matrix.pp, tangent))
    b: dot3(tangent, mat_vec3(matrix.pL, normal))
    c: dot3(normal, mat_vec3(matrix.Lp, tangent))
    d: dot3(normal, mat_vec3(matrix.LL, normal))
    determinant: a * d - b * c
    tangent_speed: dot3(velocity_after_normal, tangent)
    spin_speed: dot3(angular_after_normal, normal)
    abs_num(determinant) < 0.000000000001?
        @: (
            linear_impulse: normal_impulse,
            angular_impulse: rolling_impulse,
            tangential_impulse: [0, 0, 0],
            spin_impulse: [0, 0, 0],
            mode: contact_degenerate
        )
    desired_tangent: (0 - (1 + contact.e_t) * (d * tangent_speed - b * spin_speed)) / determinant
    desired_spin: (0 - (1 + contact.e_t) * (a * spin_speed - c * tangent_speed)) / determinant
    static_tangent_limit: contact.mu_s * abs_num(normal_impulse_magnitude)
    static_spin_limit: contact.mu_s * contact_radius * abs_num(normal_impulse_magnitude)
    dynamic_tangent_limit: contact.mu_d * abs_num(normal_impulse_magnitude)
    dynamic_spin_limit: contact.mu_d * contact_radius * abs_num(normal_impulse_magnitude)
    mode: contact_static
    tangent_magnitude: desired_tangent
    spin_magnitude: desired_spin
    abs_num(desired_tangent) > static_tangent_limit?
        .mode: contact_dynamic
    abs_num(desired_spin) > static_spin_limit?
        .mode: contact_dynamic
    mode = contact_dynamic?
        .tangent_magnitude: clamp_num(desired_tangent, 0 - dynamic_tangent_limit, dynamic_tangent_limit)
        .spin_magnitude: clamp_num(desired_spin, 0 - dynamic_spin_limit, dynamic_spin_limit)
    linear_impulse: add3(normal_impulse, scale3(tangent_magnitude, tangent))
    angular_impulse: add3(rolling_impulse, scale3(spin_magnitude, normal))
    tangential_impulse: scale3(tangent_magnitude, tangent)
    spin_impulse: scale3(spin_magnitude, normal)
    @: (
        linear_impulse: linear_impulse,
        angular_impulse: angular_impulse,
        tangential_impulse: tangential_impulse,
        spin_impulse: spin_impulse,
        mode: mode
    )

solid_contact_impulse3(
    matrix:any,
    relative_velocity:any,
    relative_angular_velocity:any,
    normal:any,
    tangent:any,
    rolling_axis:any,
    contact_radius:num,
    rolling_radius:num,
    contact:any
):
    normal_hit: normal_contact_impulse3(matrix, relative_velocity, normal, contact)
    rolling_hit: rolling_resistance_impulse3(
        matrix,
        relative_angular_velocity,
        normal,
        normal_hit.magnitude,
        rolling_radius,
        contact
    )
    rolling_magnitude: dot3(rolling_hit.impulse, rolling_axis)
    coupled_hit: coupled_contact_impulse3(
        matrix,
        relative_velocity,
        relative_angular_velocity,
        normal,
        tangent,
        rolling_axis,
        normal_hit.magnitude,
        rolling_magnitude,
        contact_radius,
        contact
    )
    linear_impulse: coupled_hit.linear_impulse
    angular_impulse: coupled_hit.angular_impulse
    normal_impulse: normal_hit.impulse
    tangential_impulse: coupled_hit.tangential_impulse
    rolling_impulse: rolling_hit.impulse
    spin_impulse: coupled_hit.spin_impulse
    friction_mode: coupled_hit.mode
    impact: normal_hit.impact
    @: (
        linear_impulse: linear_impulse,
        angular_impulse: angular_impulse,
        normal_impulse: normal_impulse,
        tangential_impulse: tangential_impulse,
        rolling_impulse: rolling_impulse,
        spin_impulse: spin_impulse,
        friction_mode: friction_mode,
        impact: impact
    )

angular_damping3(angular_velocity:any, damping:num):
    scale3(clamp_num(1 - damping, 0, 1), angular_velocity)

dice_texture():
    @: (
        kind: "dice",
        color_a: [0.98, 0.98, 1.0, 1.0],
        color_b: [0.03, 0.03, 0.04, 1.0],
        graph_width_px: 3.0
    )

rigid_material(
    name:str,
    density:num,
    e_n:num,
    e_t:num,
    mu_s:num,
    mu_d:num,
    mu_r:num
):
    restitution_threshold: 0.5
    normal_restitution: e_n
    tangent_restitution: e_t
    static_friction: mu_s
    dynamic_friction: mu_d
    rolling_friction: mu_r
    @: (
        name: name,
        density: density,
        e_n: e_n,
        e_t: e_t,
        mu_s: mu_s,
        mu_d: mu_d,
        mu_r: mu_r,
        restitution_threshold: restitution_threshold,
        normal_restitution: normal_restitution,
        tangent_restitution: tangent_restitution,
        static_friction: static_friction,
        dynamic_friction: dynamic_friction,
        rolling_friction: rolling_friction
    )

dice_material():
    rigid_material("acrylic_dice", 1180, 0.46, 0.18, 0.62, 0.48, 0.055)

felt_table_material():
    rigid_material("felt_table", 220, 0.38, 0.10, 0.74, 0.58, 0.085)

contact_material(a:any, b:any):
    e_n: max_num(a.e_n, b.e_n)
    e_t: max_num(a.e_t, b.e_t)
    mu_s: sqrt(a.mu_s * b.mu_s)
    mu_d: sqrt(a.mu_d * b.mu_d)
    mu_r: sqrt(a.mu_r * b.mu_r)
    restitution_threshold: max_num(a.restitution_threshold, b.restitution_threshold)
    normal_restitution: max_num(a.e_n, b.e_n)
    tangent_restitution: max_num(a.e_t, b.e_t)
    static_friction: sqrt(a.mu_s * b.mu_s)
    dynamic_friction: sqrt(a.mu_d * b.mu_d)
    rolling_friction: sqrt(a.mu_r * b.mu_r)
    @: (
        e_n: e_n,
        e_t: e_t,
        mu_s: mu_s,
        mu_d: mu_d,
        mu_r: mu_r,
        restitution_threshold: restitution_threshold,
        normal_restitution: normal_restitution,
        tangent_restitution: tangent_restitution,
        static_friction: static_friction,
        dynamic_friction: dynamic_friction,
        rolling_friction: rolling_friction
    )

copy_rigid_material(value:any):
    density: value.density
    e_n: value.e_n
    e_t: value.e_t
    mu_s: value.mu_s
    mu_d: value.mu_d
    mu_r: value.mu_r
    restitution_threshold: value.restitution_threshold
    normal_restitution: value.normal_restitution
    tangent_restitution: value.tangent_restitution
    static_friction: value.static_friction
    dynamic_friction: value.dynamic_friction
    rolling_friction: value.rolling_friction
    :

infinite_plane3(normal:[num:3], offset:num, source_material:any):
    mass: "infinite"
    inv_mass: 0
    inv_inertia: zero3x3()
    material: copy_rigid_material(source_material)
    @: (
        normal: normal,
        offset: offset,
        material: material,
        mass: mass,
        inv_mass: inv_mass,
        inv_inertia: inv_inertia
    )

cube_inv_inertia3(mass:num, size:num):
    i: (mass * size * size) / 6
    diag_inv3([i, i, i])

dice_body3(
    size:num,
    mass:num,
    center:[num:3],
    linear_velocity:[num:3],
    angular_velocity:[num:3],
    source_material:any
):
    inv_mass: 1 / mass
    inv_inertia: cube_inv_inertia3(mass, size)
    texture: dice_texture()
    material: copy_rigid_material(source_material)
    @: (
        size: size,
        mass: mass,
        center: center,
        linear_velocity: linear_velocity,
        angular_velocity: angular_velocity,
        material: material,
        inv_mass: inv_mass,
        inv_inertia: inv_inertia,
        texture: texture
    )

dice_roll_initial_state(seed:num):
    # Deterministic seed-to-range mapping for examples until a source-owned RNG lands.
    whole_seed: int(seed)
    a0: whole_seed
    a1: whole_seed * 7 + 3
    a2: whole_seed * 11 + 5
    a3: whole_seed * 13 + 7
    a4: whole_seed * 17 + 11
    r0: (a0 % 17) / 16
    r1: (a1 % 19) / 18
    r2: (a2 % 23) / 22
    r3: (a3 % 29) / 28
    r4: (a4 % 31) / 30
    linear_velocity: [
        1.2 + 2.1 * r0,
        0.8 + 1.6 * r1,
        4.8 + 2.7 * r2
    ]
    angular_velocity: [
        7.0 + 9.0 * r3,
        9.0 + 11.0 * r4,
        5.0 + 7.0 * r2
    ]
    @: (linear_velocity: linear_velocity, angular_velocity: angular_velocity)

first_plane_bounce3(dice:any, plane:any, contact:any):
    normal: plane.normal
    impact_linear_velocity: [
        dice.linear_velocity.0,
        dice.linear_velocity.1,
        0 - abs_num(dice.linear_velocity.2)
    ]
    relative_velocity: impact_linear_velocity
    body: collision_body3(dice.mass, dice.inv_inertia, scale3(0 - dice.size / 2, normal))
    plane_body: collision_body_inverse3(0, zero3x3(), [0.0, 0.0, 0.0])
    matrix: collision_matrix3(body, plane_body)
    normal_hit: normal_contact_impulse3(matrix, relative_velocity, normal, contact)
    friction_hit: tangential_friction_impulse3(
        matrix,
        relative_velocity,
        normal,
        normal_hit.magnitude,
        contact
    )
    linear_impulse: add3(normal_hit.impulse, friction_hit.impulse)
    angular_impulse_from_friction: cross3(body.contact_offset, friction_hit.impulse)
    after_linear_velocity: add3(impact_linear_velocity, scale3(dice.inv_mass, linear_impulse))
    after_angular_velocity_raw: add3(dice.angular_velocity, mat_vec3(dice.inv_inertia, angular_impulse_from_friction))
    rolling_hit: rolling_resistance_impulse3(
        matrix,
        after_angular_velocity_raw,
        normal,
        normal_hit.magnitude,
        dice.size / 2,
        contact
    )
    spin_hit: spin_friction_impulse3(
        matrix,
        after_angular_velocity_raw,
        normal,
        normal_hit.magnitude,
        dice.size / 2,
        contact
    )
    angular_impulse: add3(angular_impulse_from_friction, add3(rolling_hit.impulse, spin_hit.impulse))
    after_angular_velocity: add3(dice.angular_velocity, mat_vec3(dice.inv_inertia, angular_impulse))
    normal_impulse: normal_hit.impulse
    tangential_impulse: friction_hit.impulse
    rolling_impulse: rolling_hit.impulse
    spin_impulse: spin_hit.impulse
    friction_mode: friction_hit.mode
    tangential_speed: friction_hit.speed
    @: (
        after_linear_velocity: after_linear_velocity,
        after_angular_velocity: after_angular_velocity,
        normal_impulse: normal_impulse,
        tangential_impulse: tangential_impulse,
        rolling_impulse: rolling_impulse,
        spin_impulse: spin_impulse,
        friction_mode: friction_mode,
        tangential_speed: tangential_speed
    )

dice_transform_frame(center:any, rotation_degrees:any):
    rx: rotation_degrees.0 * pi / 180
    ry: rotation_degrees.1 * pi / 180
    rz: rotation_degrees.2 * pi / 180
    cx: cos(rx)
    sx: sin(rx)
    cy: cos(ry)
    sy: sin(ry)
    cz: cos(rz)
    sz: sin(rz)
    [
        [cz * cy, cz * sy * sx - sz * cx, cz * sy * cx + sz * sx, center.0],
        [sz * cy, sz * sy * sx + cz * cx, sz * sy * cx - cz * sx, center.1],
        [0 - sy, cy * sx, cy * cx, center.2],
        [0.0, 0.0, 0.0, 1.0]
    ]

dice_roll_path3(dice:any, plane:any, contact:any):
    bounce: first_plane_bounce3(dice, plane, contact)
    half_size: dice.size / 2
    rest_center: [
        dice.center.0 + dice.linear_velocity.0 * 1.38,
        dice.center.1 + dice.linear_velocity.1 * 0.92,
        half_size
    ]
    frames: [
        dice_transform_frame(dice.center, [22.0, 0.0 - 34.0, 16.0]),
        dice_transform_frame(
            [
                dice.center.0 + dice.linear_velocity.0 * 0.18,
                dice.center.1 + dice.linear_velocity.1 * 0.18,
                1.55
            ],
            [72.0, 31.0, 58.0]
        ),
        dice_transform_frame(
            [
                dice.center.0 + dice.linear_velocity.0 * 0.34,
                dice.center.1 + dice.linear_velocity.1 * 0.34,
                half_size + 0.03
            ],
            [126.0, 76.0, 104.0]
        ),
        dice_transform_frame(
            [
                dice.center.0 + bounce.after_linear_velocity.0 * 0.35,
                dice.center.1 + bounce.after_linear_velocity.1 * 0.35,
                1.05
            ],
            [194.0, 142.0, 181.0]
        ),
        dice_transform_frame(
            [
                dice.center.0 + bounce.after_linear_velocity.0 * 0.58,
                dice.center.1 + bounce.after_linear_velocity.1 * 0.58,
                half_size + 0.14
            ],
            [271.0, 211.0, 246.0]
        ),
        dice_transform_frame(
            [
                rest_center.0 - 0.18,
                rest_center.1 - 0.08,
                half_size + 0.02
            ],
            [344.0, 278.0, 319.0]
        ),
        dice_transform_frame(rest_center, [360.0, 270.0, 360.0])
    ]
    duration_seconds: 2.9
    rest_linear_velocity: [0, 0, 0]
    rest_angular_velocity: [0, 0, 0]
    first_contact: bounce
    @: (
        frames: frames,
        duration_seconds: duration_seconds,
        rest_linear_velocity: rest_linear_velocity,
        rest_angular_velocity: rest_angular_velocity,
        first_contact: first_contact
    )

settled_face_from_angular_velocity(angular_velocity:any):
    ax: angular_velocity.0
    ay: angular_velocity.1
    az: angular_velocity.2
    ax_abs: abs_num(ax)
    ay_abs: abs_num(ay)
    az_abs: abs_num(az)
    ax_abs >= ay_abs?
        ax_abs >= az_abs?
            ax > 0? @: 3
            @: 4
    ay_abs >= az_abs?
        ay > 0? @: 2
        @: 5
    az > 0? @: 1
    @: 6

physics_stdlib_capability:
    name: "physics_collision_matrix_seed"
    collision_matrix: [
        "M_pp maps linear impulse to contact relative linear velocity",
        "M_pL maps angular impulse to contact relative linear velocity",
        "M_Lp maps linear impulse to relative angular velocity",
        "M_LL maps angular impulse to relative angular velocity"
    ]
    restitution: [
        "normal_contact_impulse3 disables restitution below the resting-contact threshold",
        "coupled_contact_impulse3 solves tangential p and normal-axis L through all matrix blocks",
        "rolling_resistance_impulse3 bounds tangent-plane torque by mu_r R delta p_n"
    ]
    dice_roll: [
        "dice_body3 provides cube inertia, material, six-face dice texture, and initial state",
        "infinite_plane3 models the table as zero inverse mass and zero inverse inertia",
        "first_plane_bounce3 applies normal restitution and tangential friction to the first table impact",
        "dice_roll_path3 returns transform frames from launch to rest for scene_3d animation"
    ]
    ledger: [
        "tetra mass properties, parallel-axis aggregation, and rigid stepping are VKF source",
        "F = p dot and tau = L dot",
        "position and velocity updates can live in the runtime variable ledger",
        "code changes define functions while running loops consume mutable state"
    ]
    :
# Supported scalar-inertia contact, constant support load and tangential drive.
# Origin: svenviktorjonsson/rigid-body-collisions, research/adaptive-benchmark-validation.
# Source commit: 1098616162342d894d9c0a098f8f5ad8af427d23; supported_backend/kernel.h.
# Kernel SHA256: 6e5050759cbc00734215b4a15ded36f1dd1ca903d40cceb0149fe20fe8c8c40d.
# Port included by the source owner; upstream has no repository-level license.
# This notice preserves provenance and does not relicense upstream code.
# Fields and impulses use fixed declared axes, not changing final t/s directions.
:.math
errors:.errors

supported_sign(x:num):
 x>0? @:1
 x<0? @:0-1
 0

supported_finite(x:num): (x=x) /\ ((abs(x)-abs(x))=0) /\ ((x=abs(x)) \/ (x=0-abs(x)))

supported_max(a:num,b:num):
 a<b? @:b
 a
supported_min(a:num,b:num):
 b<a? @:b
 a

supported_candidate(active:bit,value:num,index:int):
 active? @:supported_sign(value)
 index=0? @:0
 index=1? @:0-1
 1

supported_count(active:bit):
 active? @:1
 3

supported_contact_si(mass:num,inertia:num,radius:num,normal_load:num,drive:num,velocity:num,omega:num,spin0:num,duration:num,mu_s:num,mu_d:num,mu_r:num,rolling_length:num,mu_n:num,spin_length:num):
 values:[mass,inertia,radius,normal_load,drive,velocity,omega,spin0,duration,mu_s,mu_d,mu_r,rolling_length,mu_n,spin_length]
 [..14] >>
  ~supported_finite(values.($))? errors.ValueError("nonfinite supported-contact input")!
 (mass<=0 \/ inertia<=0 \/ radius<=0)? errors.ValueError("positive mass/inertia/radius required")!
 duration<0? errors.ValueError("nonnegative duration required")!
 (normal_load<0 \/ mu_s<0 \/ mu_d<0 \/ mu_r<0 \/ rolling_length<0 \/ mu_n<0 \/ spin_length<0 \/ mu_d>mu_s)? errors.ValueError("invalid supported-contact resistance")!
 ((mu_r>0 /\ rolling_length=0) \/ (mu_n>0 /\ spin_length=0))? errors.ValueError("positive angular resistance requires a moment length")!
 eps:0.0000000000000002220446049250313
 inverse_m:1/mass
 inverse_rot:radius*radius/inertia
 inverse_R:1/radius
 mobility:inverse_m+inverse_rot
 cap:mu_r*rolling_length*inverse_R*normal_load
 static_cap:mu_s*normal_load
 dynamic_cap:mu_d*normal_load
 force_tolerance:64*eps*supported_max(supported_max(supported_max(static_cap,dynamic_cap),abs(drive)),supported_max(cap,0.))
 slip_tolerance:force_tolerance*(inverse_m+2*inverse_rot)
 rolling_tolerance:2*force_tolerance*inverse_rot
 inverse_mobility:1/mobility
 v:velocity
 q:radius*omega
 time:0.0
 dx:0.0
 p:0.0
 L:0.0
 loss_f:0.0
 loss_r:0.0
 phases:0
 h:0.0
 tolerance:0.0
 u:0.0
 sliding:false
 rolling:false
 f:0.0
 b:0.0
 dv:0.0
 dq:0.0
 du:0.0
 su:0
 sq:0
 found:false
 nu:0
 nq:0
 i:0
 j:0
 tu:0.0
 tq:0.0
 event_tolerance:0.0
 stop_u:false
 stop_q:false
 has_u:false
 has_q:false
 time<duration?>
  .phases+:1
  phases>32? errors.RuntimeError("supported-contact branch budget")!
  .tolerance:supported_min(0.000000000001,64*eps*supported_max(abs(v),abs(q)))
  .u:v-q
  abs(u)<=tolerance?
   .v:q
   .u:0.0
  abs(q)<=tolerance? .q:0.0
  .sliding:abs(u)>tolerance
  .rolling:abs(q)>tolerance
  .f:0.0
  .b:0.0
  .dv:0.0
  .dq:0.0
  .du:0.0
  .su:0
  .sq:0
  .found:false
  (sliding /\ rolling)?
   .su:supported_sign(u)
   .sq:supported_sign(q)
   .f:0-dynamic_cap*su
   .b:0-cap*sq
   .dv:(drive+f)*inverse_m
   .dq:(0-f+b)*inverse_rot
   .du:dv-dq
   .found:true
  .nu:supported_count(sliding)
  .nq:supported_count(rolling)
  .i:0
  (i<nu /\ ~found)?>
   .j:0
   (j<nq /\ ~found)?>
    .su:supported_candidate(sliding,u,i)
    .sq:supported_candidate(rolling,q,j)
    (su=0 /\ sq=0)?
     .f:0-drive
     .b:f
    (su=0 /\ sq!=0)?
     .b:0-cap*sq
     .f:(b*inverse_rot-drive*inverse_m)*inverse_mobility
    (su!=0 /\ sq=0)?
     .f:0-dynamic_cap*su
     .b:f
    (su!=0 /\ sq!=0)?
     .f:0-dynamic_cap*su
     .b:0-cap*sq
    .j+:1
    (su=0 /\ abs(f)>static_cap+force_tolerance)? @>
    (sq=0 /\ abs(b)>cap+force_tolerance)? @>
    .dv:(drive+f)*inverse_m
    .dq:(0-f+b)*inverse_rot
    .du:dv-dq
    (~sliding /\ su!=0 /\ su*du<=slip_tolerance)? @>
    (~rolling /\ sq!=0 /\ sq*dq<=rolling_tolerance)? @>
    .found:true
   .i+:1
  ~found? errors.RuntimeError("no admissible supported-contact branch")!
  .h:duration-time
  .tu:0.0
  .tq:tu
  .has_u:su!=0 /\ u*du<0
  has_u? .tu:0-u/du
  .has_q:sq!=0 /\ q*dq<0
  has_q? .tq:0-q/dq
  (tu>0 /\ tu<h)? .h:tu
  (tq>0 /\ tq<h)? .h:tq
  .event_tolerance:16*eps*supported_max(duration,h)
  .stop_u:has_u /\ abs(tu-h)<=event_tolerance
  .stop_q:has_q /\ abs(tq-h)<=event_tolerance
  h<=0? errors.RuntimeError("nonadvancing supported-contact event")!
  .dx+:v*h+0.5*dv*h*h
  .p+:f*h
  .L+:radius*b*h
  .loss_f-:f*(u*h+0.5*du*h*h)
  .loss_r-:b*(q*h+0.5*dq*h*h)
  .v+:dv*h
  .q+:dq*h
  .time+:h
  (stop_q \/ sq=0)? .q:0.0
  (stop_u \/ su=0)? .v:q
  duration-time<=8*eps*duration? .time:duration
 spin_capacity:mu_n*spin_length*normal_load*duration
 arrest:inertia*abs(spin0)
 Ln:0-supported_sign(spin0)*supported_min(spin_capacity,arrest)
 spin:spin0+Ln/inertia
 spin_capacity>=arrest? .spin:0.0
 w:q*inverse_R
 loss_n:0.5*inertia*(spin0*spin0-spin*spin)
 before:0.5*mass*velocity*velocity+0.5*inertia*(omega*omega+spin0*spin0)
 after:0.5*mass*v*v+0.5*inertia*(w*w+spin*spin)
 work:drive*dx
 loss:loss_f+loss_r+loss_n
 residual:after-before-work+loss
 scale:supported_max(supported_max(supported_max(before,after),abs(work)),supported_max(loss,0.))
 (~supported_finite(residual) \/ ~supported_finite(p) \/ ~supported_finite(L))? errors.RuntimeError("nonfinite supported-contact response")!
 (supported_min(supported_min(loss_f,loss_r),loss_n)<0-0.00000000001*scale \/ abs(residual)>0.0000000002*scale)? errors.RuntimeError("supported-contact energy gate")!
 [v,w,spin,dx,p,L,Ln,loss_f,loss_r,loss_n,residual]

