# Ordinary editable plot caller of the shared paired module.
# interp remains the existing metadata parameter; this fixture does not claim
# that the flag itself selects or evaluates a numerical interpolation method.
curve_math:.interpolation
viewport:.ui.viewport
height:2
plan:curve_math.prepare_bezier([0,0,1,height,2,height,3,0],2)
a:curve_math.sample_polynomial(plan,0)
b:curve_math.sample_polynomial(plan,0.25)
c:curve_math.sample_polynomial(plan,0.5)
d:curve_math.sample_polynomial(plan,0.75)
e:curve_math.sample_polynomial(plan,1)
x:[a.value.(0),b.value.(0),c.value.(0),d.value.(0),e.value.(0)]
y:[a.value.(1),b.value.(1),c.value.(1),d.value.(1),e.value.(1)]
viewport.add(x:x_u,y:y_u,id:"shared-curve",interp:true,color:[0.2,0.7,1,1])
viewport.show()
::a.value.(0)
::b.value.(0)
::c.value.(0)
::d.value.(0)
::e.value.(0)
::a.value.(1)
::b.value.(1)
::c.value.(1)
::d.value.(1)
::e.value.(1)
