# Public time API. Clock and blocking capabilities are direct runtime-ABI
# primitives; validation and presentation remain ordinary VKF source.

wall_time() -> num:
    time.wall_seconds()

monotonic() -> num:
    time.monotonic_seconds()

sleep(seconds:num):
    (seconds >= 0)?! "time.sleep: seconds must be non-negative"
    time.sleep_seconds(seconds)

time_stamp() -> str:
    seconds: time.wall_seconds()
    "$seconds.6f"

_two_digits(value:num) -> str:
    value < 10? @: "0" & str(int(value))
    str(int(value))

_four_digits(value:num) -> str:
    value < 10? @: "000" & str(int(value))
    value < 100? @: "00" & str(int(value))
    value < 1000? @: "0" & str(int(value))
    str(int(value))

_three_digits(value:num) -> str:
    value < 10? @: "00" & str(int(value))
    value < 100? @: "0" & str(int(value))
    str(int(value))

_iso_weekday(weekday:num) -> str:
    weekday = 0? @: "7"
    str(int(weekday))

_year_day(year:num, month:num, day:num) -> num:
    result: day - 1
    month > 1? .result: result + 31
    month > 2?
        .result: result + 28
        (year % 4 = 0 /\ (year % 100 != 0 \/ year % 400 = 0))?
            .result: result + 1
    month > 3? .result: result + 31
    month > 4? .result: result + 30
    month > 5? .result: result + 31
    month > 6? .result: result + 30
    month > 7? .result: result + 31
    month > 8? .result: result + 31
    month > 9? .result: result + 30
    month > 10? .result: result + 31
    month > 11? .result: result + 30
    result

_utc_parts(seconds:num):
    whole: seconds // 1
    days: whole // 86400
    remaining: whole - days * 86400
    hour: remaining // 3600
    .remaining: remaining - hour * 3600
    minute: remaining // 60
    second: remaining - minute * 60
    z: days + 719468
    era: z // 146097
    doe: z - era * 146097
    yoe: (doe - doe // 1460 + doe // 36524 - doe // 146096) // 365
    year: yoe + era * 400
    doy: doe - (365 * yoe + yoe // 4 - yoe // 100)
    mp: (5 * doy + 2) // 153
    day: doy - (153 * mp + 2) // 5 + 1
    month: mp + 3
    mp >= 10?
        .month: mp - 9
    month <= 2?
        .year: year + 1
    weekday: (days + 4) % 7
    weekday < 0? .weekday: weekday + 7
    (second: second, minute: minute, hour: hour, day: day, month: month,
     year: year, weekday: weekday,
     yearday: _year_day(year, month, day), dst: 0)

_format_directive(parts:any, directive:chr) -> str:
    year: _four_digits(parts.year)
    month: _two_digits(parts.month)
    day: _two_digits(parts.day)
    hour: _two_digits(parts.hour)
    minute: _two_digits(parts.minute)
    second: _two_digits(parts.second)
    directive = chr(37)? @: "%"
    directive = chr(89)? @: year
    directive = chr(121)? @: _two_digits(parts.year % 100)
    directive = chr(109)? @: month
    directive = chr(100)? @: day
    directive = chr(72)? @: hour
    directive = chr(77)? @: minute
    directive = chr(83)? @: second
    directive = chr(106)? @: _three_digits(parts.yearday + 1)
    directive = chr(119)? @: str(int(parts.weekday))
    directive = chr(117)? @: _iso_weekday(parts.weekday)
    directive = chr(70)? @: year & "-" & month & "-" & day
    directive = chr(84)? @: hour & ":" & minute & ":" & second
    false?! "unsupported portable time format directive"
    ""

_format_parts(parts:any, fmt:str) -> str:
    escaped: false
    formatted: fmt >>
        was_escaped: escaped
        output: str($)
        was_escaped?
            .output: _format_directive(parts, $)
            .escaped: false
        (~was_escaped /\ $ = chr(37))?
            .output: ""
            .escaped: true
        output
    (~escaped)?! "time format ends with an incomplete directive"
    formatted

format_time(seconds:num, fmt:str="%Y-%m-%d %H:%M:%S", utc:bit=false) -> str:
    utc?
        @: _format_parts(_utc_parts(seconds), fmt)
    _format_parts(time.local_parts(seconds), fmt)

current_time(fmt:str="%Y-%m-%d %H:%M:%S", utc:bit=false) -> str:
    format_time(time.wall_seconds(), fmt, utc)
