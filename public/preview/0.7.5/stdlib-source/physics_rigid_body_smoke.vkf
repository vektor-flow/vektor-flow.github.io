:.physics

props: tetra_mass_properties3(
    [0, 0, 0],
    [1, 0, 0],
    [0, 1, 0],
    [0, 0, 1],
    6
)

state: rigid_state3([0, 0, 0], [0, 0, 0], [0, 0, 0])
application: force_at_point3([0, 1, 0], [1.25, 0.25, 0.25], props.center_of_mass)
stepped: step_rigid_body_momentum3(state, props, 0.1, application.force, application.torque)

mass: props.mass
center_x: props.center_of_mass.0
inertia_xx: props.inertia_tensor.(0, 0)
momentum_y: stepped.momentum.1
angular_velocity_z: stepped.angular_velocity.2

:: mass
:: center_x
:: inertia_xx
:: momentum_y
:: angular_velocity_z
