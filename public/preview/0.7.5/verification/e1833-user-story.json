    "currentCopy": {
      "title": "Vektor Flow \u2014 a language experiment for scientists and mathematicians",
      "hero": "A language experiment for scientists and mathematicians.",
      "intro": "Vektor Flow began as an experiment in designing a language without keywords while trying to keep it readable.",
      "context": "It then grew to address shortcomings I encountered over years of work in data engineering and visualization.",
      "allProposedCopy": {
        "hero": "A language experiment for scientists and mathematicians.",
        "lead": "Vektor Flow began as an experiment in designing a language without keywords while trying to keep it readable.",
        "context": "It then grew to address shortcomings I encountered over years of work in data engineering and visualization.",
        "goal_heading": "Aiming for convenience without sacrificing performance.",
        "goal_paragraph": "The language is aimed at scientists and mathematicians, with fast figure and PDF article generation built in as a goal.",
        "design_paragraph": "The design aims to encourage good programming practice through guard clauses rather than nested if/else. There is no else construct. Scopes that can be evaluated directly support encapsulation.",
        "event_object_paragraph": "Transparent event matching uses the dedicated operator ??> to reduce complicated callback logic. The object model works with scopes and structs that support overriding."
      },
