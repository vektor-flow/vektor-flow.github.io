+++ b/tests/fixtures/captured-helper-erased-call.vkf
@@ -0,0 +1,12 @@
+# The hidden capture adds a physical signature to the one source helper.
+# An erased wrapper must still lower its executable body at the public arity.
+_mode: 2
+
+captured(value:any):
+    @: (amount: value.amount + _mode, marker: value.marker)
+
+combine(value:any):
+    hit: captured(value)
+    @: (amount: hit.amount, marker: hit.marker)
+
+::combine((amount: 3, marker: 0)).amount
