{
  "schemaVersion": 3,
  "settingsSchema": "interp-settings.schema.json",
  "nativeModule": "Interp.vkf",
  "facadeModule": "Interpolation.vkf",
  "clock": {
    "function": "time_coordinate",
    "domain": [
      0,
      1
    ],
    "expression": "q<0.5 ? 2*q*q : 1-2*(1-q)*(1-q)",
    "application": "once before native playback; independent of selected state path"
  },
  "modes": [
    {
      "id": "state",
      "nativeMode": 0,
      "factory": "state_interp",
      "parameters": {
        "path": {
          "linear": 0,
          "natural-cubic": 1
        }
      },
      "implementation": "same existing Morphing.prepare/sample backend"
    },
    {
      "id": "spectral",
      "nativeMode": 1,
      "factory": "spectral_interp",
      "parameters": [
        "k",
        "velocity",
        "overshoot",
        "grow"
      ],
      "channels": {
        "reveal_channel": [
          "alpha",
          "growth",
          "red",
          "green",
          "blue"
        ]
      },
      "implementation": "existing native morphing/unfold.vkf"
    },
    {
      "id": "vapor",
      "nativeMode": 2,
      "factory": "vapor_interp",
      "parameters": [
        "temperature",
        "spread",
        "lift",
        "seed",
        "k",
        "velocity",
        "overshoot",
        "grow"
      ],
      "channels": {
        "sample_vapor_transport.gas": [
          "x",
          "y",
          "alpha",
          "footprint",
          "r",
          "g",
          "b",
          "materialWeight",
          "capture"
        ],
        "target": [
          "alpha",
          "growth",
          "r",
          "g",
          "b"
        ],
        "ledger": [
          "attachedSource",
          "gas",
          "capturedTarget"
        ]
      },
      "carrierLimit": 4096,
      "seedDomain": [
        0,
        65535
      ],
      "source": "actual native ink dyadic equal-weight samples; persistent positive normalized material",
      "target": "actual native target ink + declared nearest native anchor capture control",
      "semantics": "conserved normalized material ledger; finite seeded cubic noise field, not physical Brownian/thermal dynamics; no raster area conservation claim",
      "implementation": "Morphing.prepare_material + existing state/segment kernels; prepared native ink transport",
      "emptyEndpoints": "explicitly unsupported conserved transport; spectral appearance/removal remains separate"
    }
  ],
  "routeStatus": {
    "canonicalWasm": "qualification receipt tests/interp/evidence/qualification.json",
    "gpu": "not yet qualified",
    "nativeELF": "not yet qualified",
    "renderer": "not yet integrated or visually qualified"
  },
  "batch": {
    "prepare": "prepare_vapor_transport(settings,sourceInk,targetInk,glyphs)",
    "sample": "sample_vapor_transport(plan,q,front)",
    "front": "vapor_front(settings,q,travel)",
    "inkLayout": [
      "x",
      "y",
      "r",
      "g",
      "b",
      "coverage",
      "footprint"
    ],
    "glyphLayout": [
      "x",
      "y",
      "reading",
      "r",
      "g",
      "b",
      "alpha"
    ],
    "coordinateChart": "common CSS-height units; native y up",
    "sampleCounts": "positive powers of two <=4096 at each endpoint, yielding at most4096 carriers",
    "legacyUnpreparedVapor": "removed; text_frame accepts spectral mode only",
    "numeric": "same native state/prepare plus renderer forwarding sample_state; one time_coordinate"
  },
  "nativeRecordABI": {
    "version": 2,
    "kind": "typed structural record",
    "type": "Interp:(mode:int,state:[StateSettings],reveal:[RevealSettings],vapor:[VaporSettings])",
    "optionalEncoding": "zero-or-one typed named record per applicable group; [] absent",
    "groups": {
      "state": {
        "path": "int"
      },
      "reveal": {
        "k": "num",
        "velocity": "num",
        "overshoot": "num",
        "grow": "bit"
      },
      "vapor": {
        "temperature": "num",
        "spread": "num",
        "lift": "num",
        "seed": "int"
      }
    },
    "allowedGroups": {
      "0": [
        "state"
      ],
      "1": [
        "reveal"
      ],
      "2": [
        "reveal",
        "vapor"
      ]
    },
    "positionalNumericSettingsPayloads": false,
    "namedFactoryAPI": "unchanged from d2952a9",
    "schema": "interp-native-record.schema.json"
  }
}
