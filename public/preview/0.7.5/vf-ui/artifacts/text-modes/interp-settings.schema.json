{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vektor-flow.org/contracts/interp-settings-v4.schema.json",
  "title": "Interp mode-specific settings",
  "description": "Named client settings mapped to native VKF named factories. Defaults are resolved by native factory; schema presence alone never grants capability.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "const": "state"
        },
        "path": {
          "enum": [
            0,
            1,
            "linear",
            "natural-cubic"
          ],
          "default": 0
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "const": "spectral"
        },
        "k": {
          "type": "number",
          "minimum": 1,
          "maximum": 10,
          "default": 4
        },
        "velocity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.54
        },
        "overshoot": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.5,
          "default": 0.32
        },
        "grow": {
          "type": "boolean",
          "default": true
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "const": "vapor"
        },
        "temperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 1
        },
        "spread": {
          "type": "number",
          "minimum": 0,
          "maximum": 4,
          "default": 0.35
        },
        "lift": {
          "type": "number",
          "minimum": 0,
          "maximum": 4,
          "default": 0.65
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535,
          "default": 0
        },
        "velocity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.54
        },
        "footprint": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 1,
          "default": 0.45
        },
        "captureWidth": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 4,
          "default": 0.45
        },
        "boundary": {
          "enum": [
            "closed",
            "emit",
            "exit",
            "exchange"
          ],
          "default": "exchange"
        },
        "captureStart": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 1,
          "default": 0.35
        },
        "captureEnd": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "default": 0.85
        }
      },
      "description": "Native material capture; captureStart < captureEnd enforced by native factory. Fractions refer to raw normalized playback time."
    }
  ]
}
