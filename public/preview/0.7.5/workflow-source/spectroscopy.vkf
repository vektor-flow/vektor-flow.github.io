stat:.stat
energy:[-1.0,0.0,1.0]_u
spectra:[[1.0,5.0,2.0],[2.0,3.0,4.0],
         [3.0,8.0,4.0],[4.0,5.0,6.0]]_pu
span(x):stat.max(x)-stat.min(x)
contrast:span_u(spectra)
::contrast
selected:spectra.(2,:)
::selected
view:.ui.viewport
view.add(x:energy_u,y:selected_u,color:[0.25,0.72,1,1])
view.push(x_lim:[-1,1],y_lim:[0,10])
view.show()
