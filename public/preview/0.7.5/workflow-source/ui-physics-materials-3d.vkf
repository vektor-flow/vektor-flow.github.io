# Orbit with drag/arrows; wheel/toolbar zoom out and in. Edit then Run.
# Physical ray coefficients come from VKF; shader roughness is Blinn approximation.
:.physics.optics
scene():
    view: .ui.viewport
    n: 1.5
    f: fresnel(1, n, 1)
    plate: [[-2, -1, 0], [2, -1, 0], [2, 1, 0], [-2, 1, 0]]
    faces: [[0, 1, 2], [0, 2, 3]]
    block: [[-0.5, -0.5, 0.02], [0.5, -0.5, 0.02], [0.5, 0.5, 0.02], [-0.5, 0.5, 0.02]]
    source: [[-1, 0, 1], [-0.5, 0, 1], [-0.5, 0.5, 1], [-1, 0.5, 1]]
    view.add(p_up: plate, faces_uvw: faces, id: "receiver", color: [0.5, 0.65, 0.8, 1], roughness: 0.35, reflectivity: f.rs, texture: (kind: "checker", roughness_modulation: 0.15, bump_strength: 0.08, detail_frequency: 12))
    view.add(p_up: block, faces_uvw: faces, id: "grass", color: [0.12, 0.42, 0.08, 1], roughness: 0.85, texture: (kind: "grass", roughness: 0.85, blade_length: 1.2, clump_density: 1.3, micro_shadow: 0.7))
    view.add(p_up: source, faces_uvw: faces, id: "emitter", color: [1, 0.7, 0.3, 1], emissivity: 0.8, emission: 0.8, optical_index: n, transparency: 0)
    view.add_light(id: "lamp", kind: "spot", pos: [-1, 0, 2], target: [0, 0, 0], color: [1, 0.85, 0.6, 1], intensity: 5, source_radius: 0.08, spread: 1, inner_cone_deg: 18, outer_cone_deg: 30, range: 12, casts_shadow: true)
    view.add_camera(pos: [4, -5, 3], target: [0, 0, 0], up: [0, 0, 1], fov: 40)
    view.push()
    view.show()
scene()
