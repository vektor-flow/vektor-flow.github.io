: .ui.display
: .physics
geometry: .geometry
materials: .materials

world: World(dim:3,time_step:1 / 120)
display: Display(dim:3)
view: display.append(world,axis:false)
tree: world.add(p_ij:[[0,0,0]],properties:materials.tree)
lawn: world.add(p_ij:[[-6,-6,0],[6,6,0]],properties:materials.lawn)
nodes: world.add(p_ij:geometry.nodes(),properties:materials.elastic)
sun: world.add(p_ij:[[-50,140,65]],properties:materials.sun)
air: world.add(p_ij:geometry.parcels(),mass_i:0..63999 >> 0.02480625,properties:materials.air)
world.push((kind:"wind",layer:air,nodes:nodes,solid:tree,grass:lawn))
view.set(embedding:(kind:"scene",),controls:(title:"Generated tree · coherent particle air",orbit:true,wind:true,grass:true,particles:true,pause:true,reset:true,
    tree_generation:(height:(min:3,max:8,step:0.25,value:8),split_factor:(min:0,max:1,step:0.05,value:0.65),turning_factor:(min:0,max:1,step:0.05,value:0.5),species:["oak","birch","beech"],distribution:["uniform","normal","triangular"])))
display.show()
