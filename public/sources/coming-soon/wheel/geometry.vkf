: .math

# Paired vertices form a closed line-list. Analytic contact is not tessellated.
rim():
    0..95 >> [0.5 * cos(6.283185307179586 * floor(($ + 1) / 2) / 48),
        0.32 + 0.5 * sin(6.283185307179586 * floor(($ + 1) / 2) / 48)]
rim_properties: (fixed:true,plot:"lines",boundary:(kind:"circle",center:[0,0.32],radius:0.5))
baffle_properties: (fixed:true,plot:"lines",boundary:(kind:"segments",half_width:0.006))

# Four rim-adjacent and three interior segments in this authored example.
baffles:[
    [0.5,0.32],[0.35,0.32], [0,0.82],[0,0.67],
    [-0.5,0.32],[-0.35,0.32], [0,-0.18],[0,-0.03],
    [-0.22,0.495],[-0.075,0.455], [0.075,0.265],[0.215,0.205],
    [-0.105,0.07],[0.02,0.165]
]
