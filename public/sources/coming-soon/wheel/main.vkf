# Coming Soon water wheel. Sand remains an independent research application.
: .ui.display
: .physics
: .math
geometry: .geometry
materials: .materials
particles: .particles

water_world: World(dim:2,time_step:1 / 480)
display: Display(dim:2)
water_view: display.append(water_world,axis:false)
water_rim: water_world.add(p_ij:geometry.rim(),properties:geometry.rim_properties)
water_baffles: water_world.add(p_ij:geometry.baffles,properties:geometry.baffle_properties)
fluid: water_world.add(p_ij:particles.water,mass_i:0..1904 >> 0.06941881433250364,volume_i:0..1904 >> 0.00006941881433250364,properties:materials.water)
water_world.push((kind:"gravity",acceleration:[0,-9.82]))
water_world.push((kind:"contact",boundaries:[water_rim,water_baffles],rotation:0.22,maximum_angular_speed:8))
water_world.push((kind:"liquid",layer:fluid,divergence_iterations:1,density_iterations:2))
water_view.set(embedding:(kind:"material",layer:fluid),controls:(title:"Water in a one-metre wheel",rotation:true,particles:true,pause:true,start_paused:true,reset:true))
water_status: water_view.add(at:[0.025,0.035],space:"relative",text:"WATER  |  %COUNT% vertices  |  D %DIAMETER% m  |  %MODE%",font_size:13,color:[0.65,0.77,0.77,1])
water_clock: water_view.add(at:[0.025,0.085],space:"relative",text:"t %TIME% s  |  wheel %ANGLE% rad",font_size:13,color:[0.65,0.77,0.77,1])
display.flip(water_view)
display.show()
