# Reusable named property groups. No geometry type is privileged as water/sand.
# These properties have an effect only when the matching World law consumes them.
water: (density:1000,spacing:0.009,lattice:"hexagonal",viscosity:1.8,bulk_modulus:2200000000,color:[0.25,0.65,0.8,1],size:0.004)
sand: (density:1600,spacing:0.01503,radius:0.0075,time_step:1 / 120,friction:0.60,wall_friction:0.45,
    restitution:0.0,rolling_resistance:0.05,color:[0.8,0.65,0.35,1],size:0.001)
