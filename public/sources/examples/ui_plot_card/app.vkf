
viewport: .ui.viewport
plot: viewport.add_panel(pos:[0.04, 0.08], size:[0.67, 0.82])
plot.set_geom_options(background:[0.012, 0.02, 0.04, 1.0])

trend: plot.add(
    x:[[-1.0, 1.0], [-1.0, 1.0]]_uv,
    y:[[-0.18, 0.46], [0.14, 0.82]]_uv,
    z:[[0.0, 0.0], [0.0, 0.0]]_uv,
    id:"trend",
    color:[0.18, 0.78, 0.96, 1.0]
)

reference: plot.add(
    x:[[-1.0, 1.0], [-1.0, 1.0]]_uv,
    y:[[0.0, 0.0], [0.04, 0.04]]_uv,
    z:[[0.0, 0.0], [0.0, 0.0]]_uv,
    id:"reference",
    color:[0.92, 0.68, 0.24, 0.72],
    alpha:0.72,
    transparent:true
)

card: viewport.add_panel(pos:[0.74, 0.08], size:[0.22, 0.82])
card.load("ui/main.html")
