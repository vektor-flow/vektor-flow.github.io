# Direct I/O keeps presentation policy in VKF and exposes only capabilities
# that must cross the operating-system boundary. File byte buffers use `str`
# storage because the language deliberately has no separate bytes primitive.

io_stdlib_capability:
    name: "io"
    source_policy: ["UTF-8 text", "string-backed byte buffers"]
    runtime_abi: ["stdin", "stdout", "stderr", "open", "read", "write", "seek", "close"]
    direct: ["print", "eprint", "read_line", "read_text", "write_text", "append_text", "read_bytes", "write_bytes"]
    :
