# Renderer-only adapter exports; the state/field/unfolding algorithms are VKF's.
contour_field_evenodd(vertices:[num],rings:[int],size:int)->[num]:b.polygon_field(vertices,rings,size,false)
contour_field(vertices:[num],rings:[int],size:int)->[num]:b.polygon_field(vertices,rings,size,true)
Surface:(plan:GeometryPlan,values:[num],scale:num,neck:num)
prepare_surface(plan:GeometryPlan,coordinate:num,scale:num)->Surface:presentation.prepare_surface(plan,coordinate,scale)
surface_row(surface:Surface,size:int,row:int,lo:[num],hi:[num],extent:num,color:[num])->[num]:presentation.surface_row(surface,size,row,lo,hi,extent,color)

# One presentation clock, independent of linear/cubic state selection.
time_coordinate(q:num)->num:
    (q>=0 /\ q<=1)?! "presentation coordinate outside 0–1"
    q<0.5? @:2*q*q
    @:1-2*(1-q)*(1-q)

unfold_alpha(distance:num,k:num)->num:unfold.alpha(distance,k)
unfold_growth(a:num,coefficient:num)->num:unfold.growth(a,coefficient)
unfold_coefficient(overshoot:num)->num:unfold.back_coefficient(overshoot)
unfold_color(a:num,channel:int)->num:unfold.color_channel(a,channel)
unfold_reading(offset:num,line:int,local:num,k:num)->num:unfold.reading_coordinate(offset,line,local,k)
# Palette mapping of the existing spectral finish to the authored ink color.
unfold_ink_color(a:num,channel:int,finish:num)->num:
    value:unfold.color_channel(a,channel)
    a<=0.8? @:value
    @:value+(finish-1)*unfold.color_channel(a,1)
# One prepared field and one contour packet per cohort/frame. The existing
# prepared-axis kernel avoids resampling all state channels for every row.
contour_mesh(values:[num],size:int,extent:num,color:[num])->[num]:presentation.triangles(values,size,extent,color)
# Existing dispatch control layout, supplied by VKF rather than host arithmetic.
gpu_controls(plan:GeometryPlan,coordinate:num,desired:num,resolution:int,lattice:int,extent:num,offset_x:num,offset_y:num)->[num]:
    i:s.interval(plan.curve.knots,coordinate)
    h:plan.curve.knots.(i+1)-plan.curve.knots.(i)
    u:(coordinate-plan.curve.knots.(i))/h
    neck:plan.join*16*u*u*(1-u)*(1-u)
    spacing:2/num(resolution)
    @:[num(plan.dimension),num(plan.size),num(plan.stride),num(plan.carriers),num(resolution),-1,-1,0,1,1,0,1,neck,spacing,spacing*spacing,desired,0.0001,0.125,4,0,extent,num(i),u,h,num(plan.curve.count),num(plan.curve.width),0,0,0,1,0,0,0,num(lattice),offset_x,offset_y]

# Authored RGBA and geometric controls share the exact prepared state clock.
# No opacity lifecycle is synthesized for unmatched glyphs.
gpu_ink_controls(plan:GeometryPlan,coordinate:num,desired:num,resolution:int,lattice:int,extent:num,offset_x:num,offset_y:num,color:[num])->[num]:
    (color.length()=4)?! "state field requires authored RGBA"
    packet:gpu_controls(plan,coordinate,desired,resolution,lattice,extent,offset_x,offset_y)
    packet.(17):0.000001
    i:0
    i<4?>
        packet.(26+i):color.(i)
        .i:i+1
    @:packet
# Bounded native diagnostic: the same geometric measure used by calibration.
geometry_measure_at(plan:GeometryPlan,coordinate:num,scale:num)->num:
    surface:presentation.prepare_surface(plan,coordinate,scale)
    frame:b.raster(plan,surface.values,65,[-1,-1],[1,1],scale,surface.neck)
    @:frame.measure
# Positive interior is necessary: AA coverage alone must not certify material.
geometry_peak_at(plan:GeometryPlan,coordinate:num)->num:
    curve:plan.curve
    knots:curve.knots
    mapping:s.clock(knots,coordinate,plan.smooth_start,plan.smooth_end)
    interval:s.interval(knots,mapping.coordinate)
    h:knots.(interval+1)-knots.(interval)
    u:(mapping.coordinate-knots.(interval))/h
    values:curve.values
    second:curve.second
    width:curve.width
    carriers:plan.carriers
    stride:plan.stride
    cells:plan.cells
    start:2*plan.dimension
    before:interval*width
    after:(interval+1)*width
    peak: -1000000.0
    carrier:0
    carrier<carriers?>
        i:0
        i<cells?>
            at:carrier*stride+start+i
            value:segment.value(values.(before+at),values.(after+at),second.(before+at),second.(after+at),h,u)
            .peak:b.maximum(peak,value)
            .i:i+1
        .carrier:carrier+1
    @:peak

# Small diagnostics reuse the exact native scalar segment evaluator. No color
# averaging or separate timing law; all four channels are prepared carrier state.
segment:.morphing.segment
geometry_attributes_at(plan:GeometryPlan,coordinate:num)->[num]:
    curve:plan.curve
    (curve.count=2 /\ curve.knots.(0)=0 /\ curve.knots.(1)=1 /\ coordinate>=0 /\ coordinate<=1 /\ plan.stride=2*plan.dimension+plan.cells+4)?! "native RGBA state profile"
    values:curve.values
    second:curve.second
    width:curve.width
    stride:plan.stride
    start:2*plan.dimension+plan.cells
    [num] out:[0:4*plan.carriers]
    i:0
    i<out.length()?>
        at:(i//4)*stride+start+i%4
        out.(i):segment.value(values.(at),values.(width+at),second.(at),second.(width+at),1,coordinate)
        .i:i+1
    @:out

# Sparse event preparation and frame controls from the same native state backend.
event_fields:.EventFields
state_controls:.StateControls
CurveLayout:(knots:[num],count:int,width:int,mode:int)
GeometryLayout:(dimension:int,size:int,stride:int,carriers:int,width:int,join:num)
EventLayout:(source:int,target:int,support:int,grow:int,shrink:int,source_attributes:int,target_attributes:int,weights:int)
StateDescriptor:(curve:CurveLayout,geometry:GeometryLayout,density:bit,events:[EventLayout])
StateEventPlan:(embedding:Curve,weights:[num],parent:[int],children:[int],coordinates:[num],first_coordinates:[num],root_coordinate:num,centers:[num])
StateInputChunk:(offset:int,values:[num])
PreparedEventFields:(chunks:[StateInputChunk],input_width:int,controls:StateDescriptor,weights:[num],embedding:Curve,events:StateEventPlan,event_coordinates:[num],direction:int,source_rgba:[num],target_rgba:[num],identity:bit)
prepare_event_fields(plan:GeometryPlan,source_count:int,target_count:int,weights:[num])->PreparedEventFields:event_fields.prepare(plan,source_count,target_count,weights)
event_controls(desc:StateDescriptor,q:num,desired:num,extent:num,offset_x:num,offset_y:num,viewport:[num])->[num]:state_controls.sample(desc,q,desired,129,257,extent,offset_x,offset_y,[1,1,1,1],viewport,1)
native_dispatch:.morphing.dispatch
raster_gpu_controls(params:[num])->[num]:native_dispatch.raster_controls(params)
