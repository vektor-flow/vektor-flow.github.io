# Experimental text entrance. Explicit growth from zero area, not conserved material.
# All motion comes from the existing Morphing natural-cubic state interpolator.
m:.Morphing

animation(groups:int,frames:int)->bit:
    (groups>0 /\ frames>1)?! "Invalid entrance dimensions"
    count:groups+4
    width:groups*4
    [num] knots:[0:count]
    [num] states:[0:count*width]
    k:0
    k<count?>
        knots.(k):k
        g:0
        g<groups?>
            at:k*width+g*4
            # Channels: horizontal offset, vertical offset, x scale, y scale.
            states.(at): -0.3
            states.(at+1):0.8
            k=g+1?
                states.(at):0.04
                states.(at+1): -0.16
                states.(at+2):0.84
                states.(at+3):1.2
            k>g+1?
                states.(at):0
                states.(at+1):0
                states.(at+2):1
                states.(at+3):1
            .g:g+1
        .k:k+1
    plan:m.prepare(knots,states,width,1,true,true)
    f:0
    f<frames?>
        [num] output:[0:width]
        # Half-second blank lead; two seconds for reading at the end (12s film).
        time:12*num(f)/num(frames-1)
        q:(time-0.5)/9.5*num(groups+1)
        q<0? .q:0
        q>num(count-1)? .q:num(count-1)
        sample:m.sample(plan,q)
        g:0
        g<groups?>
            source:g*4
            target:source
            c:0
            c<4?>
                output.(target+c):sample.value.(source+c)
                .c:c+1
            # Natural cubic is not monotone. Keep unborn groups exactly absent,
            # prevent negative sizes, and settle old groups exactly at identity.
            q<=num(g)?
                output.(target+2):0
                output.(target+3):0
            q>=num(g+3)?
                output.(target):0
                output.(target+1):0
                output.(target+2):1
                output.(target+3):1
            output.(target+2)<0? output.(target+2):0
            output.(target+3)<0? output.(target+3):0
            .g:g+1
        ::output
        .f:f+1
    @:true
