# Scalar surface evaluation for one coincident-parent -> two-child LaTeX cohort.
# Input: local progress, parent field at retained child, parent field at new child,
# target field at new child, local neck radius. Ownership/embeddings are prepared
# by the LaTeX adapter. Positive fields are inside; no opacity birth.
f:.field
s:.segment
kernel(index:int,params:[num],values:[num])->num:
    q:params.(0)
    child:s.value(params.(2),params.(3),0,0,1,q)
    neck:params.(4)*4*q*(1-q)
    @:f.union(params.(1),child,neck)
::kernel(0,[0.5,1,1,2,0.1],[0])
