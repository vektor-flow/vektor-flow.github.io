g:.morphing.dispatch
state_job(index:int,params:[num],values:[num])->num:g.state(index,params,values)
carrier_job(index:int,params:[num],values:[num])->[num]:g.carrier_mesh_packet(index,params,values)
first_job(index:int,params:[num],values:[num])->num:g.state_pose_first(index,params,values)
kernel(index:int,params:[num],values:[num])->num:
    params.length()=54? @:g.raster_calibrate(index,params,values)
    @:g.calibrate(index,params,values)
raster(params:[num])->[num]:g.raster_controls(params)
calibrate_job(index:int,params:[num],values:[num])->num:g.raster_calibrate(index,params,values)
::1
area_job(index:int,params:[num],values:[num])->num:g.carrier_area(index,params,values)
density_job(index:int,params:[num],values:[num])->num:g.material_density(index,params,values)
accumulate_job(index:int,params:[num],values:[num])->[num]:g.material_accumulate(index,params,values)
resolve_job(index:int,params:[num],values:[num])->[num]:g.material_resolve(index,params,values)
